@inherits LayoutComponentBase

<PageTitle>@SharedLocalize.GetLocalizedStringValue("ControlPanel")</PageTitle>

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">

           @* <AuthorizeView>
                <NotAuthorized>
                    NotAut
                </NotAuthorized>
                <Authorized>*@
            <MainNav Orders="@Orders" Customers="@Customers" Languages="@Languages" user="user" lang="@lang"></MainNav>
             @*  </Authorized>
                <Authorizing>
                    <p>Authorizing...</p>
                </Authorizing>
            </AuthorizeView>*@
           
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>
@code {
    public List<CustomerDto> Customers { get; set; }
    public List<OrderDto> Orders { get; set; }
    public List<LanguageDto> Languages { get; set; }
    public AdminDto user { get; set; }
    public string lang { get; set; }
    protected override async Task OnInitializedAsync()
    {
        http.DefaultRequestHeaders.Add("Accept", "application/json");
        lang = await http.GetFromJsonAsync<string>("api/Language/GetDefaultLanugage");
        user = await http.GetFromJsonAsync<AdminDto>("api/Account/currentUser");
        Languages = await http.GetFromJsonAsync<List<LanguageDto>>("api/Language/GetLanguages");
        Customers = await http.GetFromJsonAsync<List<CustomerDto>>("api/Home/getNewCustomers");
        Orders = await http.GetFromJsonAsync<List<OrderDto>>("api/Home/getNewOrders");
    }

   
}