@code {
    public List<CustomerDto> Customers { get; set; }
    public List<OrderDto> Orders { get; set; }
    public List<LanguageDto> Languages { get; set; }
    //public AdminDto user { get; set; }
    public string lang { get; set; }
    protected override async Task OnInitializedAsync()
    {
        lang = await _homeBL.GetDefaultLanugage();
        Languages = await http.GetFromJsonAsync<List<LanguageDto>>("api/Account/GetLanguages");
        //user = await _homeBL.GetCurrentUser(1);
        //await http.GetFromJsonAsync<AdminDto>("api/Account/currentUser");
        Customers = await http.GetFromJsonAsync<List<CustomerDto>>("api/Home/getNewCustomers");
        Orders = await http.GetFromJsonAsync<List<OrderDto>>("api/Home/getNewOrders");
    }
    private CultureInfo[] supportedCultures = new[]
    {
        new CultureInfo("en"),
        new CultureInfo("ar"),
    };

    protected override void OnInitialized()
    {
        Culture = CultureInfo.CurrentCulture;
    }

    private CultureInfo Culture
    {
        get => CultureInfo.CurrentCulture;
        set
        {
            if (CultureInfo.CurrentCulture != value)
            {
                var uri = new Uri(NavigationManager.Uri)
                    .GetComponents(UriComponents.PathAndQuery, UriFormat.Unescaped);
                var cultureEscaped = Uri.EscapeDataString(value.Name);
                var uriEscaped = Uri.EscapeDataString(uri);

                NavigationManager.NavigateTo(
                    $"Culture/Set?culture={cultureEscaped}&redirectUri={uriEscaped}",
                    forceLoad: true);
            }
        }
    }

}