@code {
   
    [Parameter]
    public string lang { get; set; }
    //_homeBL.GetDefaultLanugage();
    private string NavMenuCssClass => collapseNavMenu ? "collapse" : null;
    private NavSubmenu navSubmenu = NavSubmenu.None;
    private bool collapseNavMenu = true;

    private AdminDto user { get; set; }

    private void ToggleNavMenu(NavSubmenu? submenu = null)
    {
        collapseNavMenu = !collapseNavMenu;
        navSubmenu = submenu ?? navSubmenu;

    }
    private void TogleSubmenu(NavSubmenu submenu)
    {
        if (navSubmenu == submenu)
            navSubmenu = NavSubmenu.None;
        else
            navSubmenu = submenu;
    }
    protected override async Task OnInitializedAsync()
    {
        http.DefaultRequestHeaders.Add("Accept", "application/json");
        lang = await http.GetFromJsonAsync<string>("api/Language/GetDefaultLanugage");
        user = await http.GetFromJsonAsync<AdminDto>("api/Account/currentUser");
        
    }

    
}
