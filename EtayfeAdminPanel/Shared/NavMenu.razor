
<div class="top-row pl-4 navbar navbar-dark">
    @if(user != null)
    {
        if (user.UserType == UserType.Admin)
        {
            user.RoleName = @SharedLocalize.GetLocalizedStringValue("admin");
        }
        else
        {
            user.RoleName = @SharedLocalize.GetLocalizedStringValue("vendor");
        }
        <a class="navbar-brand" href="/index"> <b>@user.RoleName</b></a>
    }
    <button class="navbar-toggler" @onclick="() => ToggleNavMenu(navSubmenu)">
        <span class="navbar-toggler-icon"></span>
    </button>
</div>

<div class="@NavMenuCssClass">
    @if(links != null)
    {
        <ul class="nav flex-column">
            @foreach(var link in links)
            {
                if (link.NavSubmenu == NavSubmenu.None)
                {
                    <li class="nav-item px-3">
                        <NavLink class="nav-link" href="@link.Url">
                            <span class="@link.Icon" aria-hidden="true"></span> @SharedLocalize.GetLocalizedStringValue(link.Title)
                        </NavLink>
                    </li>
                }
                else
                {
                    if(link.ParentId == 0)
                    {
                        <li class="nav-item px-3">
                            <NavLink class="nav-link" @onclick="() => TogleSubmenu(link.NavSubmenu)">
                                <span class="@link.Icon" aria-hidden="true"></span> @SharedLocalize.GetLocalizedStringValue(link.Title)
                            </NavLink>
                        </li>
                        @if (navSubmenu == link.NavSubmenu)
                        {
                            var subLinks = links.Where(x => x.ParentId == link.Id).ToList();
                            @if (subLinks.Count > 0)
                            {
                                @foreach (var subLink in subLinks)
                                {
                                    <li class="nav-item px-5">
                                        <NavLink class="nav-link" @onclick="() => ToggleNavMenu()" href="@subLink.Url">
                                            <span class="@subLink.Icon" aria-hidden="true"></span>  @SharedLocalize.GetLocalizedStringValue(subLink.Title)
                                        </NavLink>
                                    </li>
                                }
                            }
                        }
                        
                    }
                   
                }
               
            }
           
        </ul>
    }
    
</div>

@code {
   
    [Parameter]
    public string lang { get; set; } 
    public List<LinkDto> links { get; set; }
    private string NavMenuCssClass => collapseNavMenu ? "collapse" : null;
    private NavSubmenu navSubmenu = NavSubmenu.None;
    private bool collapseNavMenu = true;

    private AdminDto user { get; set; }

    private void ToggleNavMenu(NavSubmenu? submenu = null)
    {
        collapseNavMenu = !collapseNavMenu;
        navSubmenu = submenu ?? navSubmenu;

    }
    private void TogleSubmenu(NavSubmenu submenu)
    {
        if (navSubmenu == submenu)
            navSubmenu = NavSubmenu.None;
        else
            navSubmenu = submenu;
    }
    protected override async Task OnInitializedAsync()
    {
        http.DefaultRequestHeaders.Add("Accept", "application/json");
        lang = await http.GetFromJsonAsync<string>("api/Language/GetDefaultLanugage");
        user = await http.GetFromJsonAsync<AdminDto>("api/Account/currentUser");
        links = await http.GetFromJsonAsync<List<LinkDto>>("api/Home/GetLinksRole/" + user.RoleId);
        
    }

    
}
