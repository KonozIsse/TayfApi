@page "/CP/Categories/Add/"
<PageTitle>@SharedLocalize.GetLocalizedStringValue("addcategory") | @SharedLocalize.GetLocalizedStringValue("ControlPanel")</PageTitle>
<Alert Message="@message" Style="@style"></Alert>
<section class="content-header">
    <h1>@SharedLocalize.GetLocalizedStringValue("addcategory")<small>@SharedLocalize.GetLocalizedStringValue("EditSubCategories")</small> </h1>
    <ol class="breadcrumb">
        <li class="fa fa-dashboard"><a href="/">@SharedLocalize.GetLocalizedStringValue("dashboard")</a></li>
        <li class="fa fa-users"><a href="/CP/">@SharedLocalize.GetLocalizedStringValue("categories")</a></li>
        <li class="fa fa-users"><a href="SubCategories">@SharedLocalize.GetLocalizedStringValue("categories")</a> </li>
        <li class="active">@SharedLocalize.GetLocalizedStringValue("addcategory")</li>
    </ol>
</section>
<section class="content">
    <!-- Info boxes -->
    <!-- /.row -->

    <div class="row">
        <div class="col-md-12">
            <div class="box">
                <div class="box-header">
                    <h3 class="box-title">@SharedLocalize.GetLocalizedStringValue("addcategory")</h3>
                </div>

                <!-- /.box-header -->
                <div class="box-body">
                    <div class="row">
                        <div class="col-xs-12">
                            <div class="box box-info">
                                <br>
                                <EditForm Model="create" OnInvalidSubmit="CreateCategory">
                                    <DataAnnotationsValidator />
                                    <div class="form-horizontal">
                                        <div class="box-body">

                                                <div class="form-group">
                                                    <label class="col-sm-2 col-md-3 control-label">@SharedLocalize.GetLocalizedStringValue("Name") <span style="color:red;">*</span> (en)</label>
                                                    <div class="col-md-8">
                                                        <InputText @bind-Value="create.CategoryName" class="form-control" />
                                                    <ValidationMessage For="@(() => create.CategoryName)" />
                                                    </div>
                                                </div>
                                                <div class="form-group">
                                                    <label class="col-sm-2 col-md-3 control-label">@SharedLocalize.GetLocalizedStringValue("Name") <span style="color:red;">*</span> (ar)</label>
                                                    <div class="col-md-8">
                                                        <InputText @bind-Value="create.CategoryNameAr"  class="form-control" />
                                                    <ValidationMessage For="@(() => create.CategoryNameAr)" />
                                                    </div>
                                                </div>
                                       
                                            <div class="form-group" id="imageIcone">
                                                <label class="col-sm-2 col-md-3 control-label">@SharedLocalize.GetLocalizedStringValue("img")<span style="color:red;">*</span></label>
                                                <div class="col-sm-10 col-md-4">
                                                    <!-- Modal -->
                                                    <div class="modal fade embed-images" id="ModalmanufacturedICone" tabindex="-1" role="dialog" aria-labelledby="myModalLabel">
                                                        <div class="modal-dialog" role="document">
                                                            <div class="modal-content">
                                                                <div class="modal-header">
                                                                    <button type="button" class="close" data-dismiss="modal" id="closemodal" aria-label="Close"><span aria-hidden="true">×</span></button>
                                                                    <h3 class="modal-title text-primary" id="myModalLabel">@SharedLocalize.GetLocalizedStringValue("addImg")</h3>
                                                                </div>
                                                                <div class="modal-body manufacturer-image-embed">
                                                                    <ImagesPage1 images="images"></ImagesPage1>
                                                                </div>
                                                                <div class="modal-footer">
                                                                    <a href="/CP/Media" target="_blank" class="btn btn-primary pull-left">@SharedLocalize.GetLocalizedStringValue("addImg")</a>

                                                                    <a class="btn btn-default refresh-image shownotify newIcon" id="reff" style="margin-right: 5px;"><i class="fa fa-refresh"></i></a>
                                                                    <button type="button" class="btn btn-success" id="selectedICONE" data-dismiss="modal">@SharedLocalize.GetLocalizedStringValue("add")</button>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div id="imageselected">
                                                        <input value="Categories" hidden id="typeImg" />
                                                        <a id="newIcon" data-id="1" class="newIcon btn btn-primary field-validate" data-toggle="modal" data-target="#ModalmanufacturedICone" type="button">@SharedLocalize.GetLocalizedStringValue("addImg")</a>
                                                        <br>
                                                        <div id="selectedthumbnailIcon" class="selectedthumbnail col-md-5"> </div>
                                                        <div class="closimage">
                                                            <button type="button" class="close pull-left image-close " id="image-Icone" style="display: none; position: absolute;left: 105px; top: 54px; background-color: black; color: white; opacity: 2.2; " aria-label="Close">
                                                                <span aria-hidden="true">×</span>
                                                            </button>
                                                        </div>
                                                    </div>
                                                    <img id="imgCont" width="80px" />
                                                    <span class="help-block" style="font-weight: normal;font-size: 11px;margin-bottom: 0;">@SharedLocalize.GetLocalizedStringValue("UploadYourImages")</span>

                                                    <br>
                                                </div>
                                            </div>

                                            <div class="form-group">
                                                <label class="col-sm-2 col-md-3 control-label">@SharedLocalize.GetLocalizedStringValue("status")</label>
                                                <div class="col-sm-10 col-md-4">
                                                    <InputSelect class="form-control" @bind-Value="create.IsStatus">
                                                        <option value="@Status.Active">@SharedLocalize.GetLocalizedStringValue("active")</option>
                                                        <option value="@Status.NotActive">@SharedLocalize.GetLocalizedStringValue("notActive")</option>
                                                    </InputSelect>
                                                    <ValidationMessage For="@(() => create.IsStatus)" />
                                                    <span class="help-block" style="font-weight: normal;font-size: 11px;margin-bottom: 0;">
                                                        @SharedLocalize.GetLocalizedStringValue("chooseStatus")
                                                    </span>
                                                </div>
                                            </div>




                                            <div class="box-footer text-center">
                                                <button type="submit" class="btn btn-primary">@SharedLocalize.GetLocalizedStringValue("Submit")</button>
                                                <a class="btn btn-defult" href="/CP/Categories">@SharedLocalize.GetLocalizedStringValue("back")</a>
                                            </div>

                                        </div>

                                    </div>
                                </EditForm>
                            
                            </div>
                           
                        </div>

                    </div>
                    <!-- /.box-body -->
                </div>
                <!-- /.box -->
            </div>
            <!-- /.col -->
        </div>
    </div>

</section>
@code {

    public CreateCategoryDto create { get; set; }

    public List<ImageSettingDto> images;

    protected override async Task OnInitializedAsync()
    {
        create = new CreateCategoryDto();
        images = await _imageBL.GetAllImageSettingOriginal(0);
    }
    string message = "";
    string style = "";
    async Task CreateCategory()
    {
        create.ImgId = 5;
        var result = await _productBL.CreateCategory(create);
        if (result.Success)
        {
            message = result.Message;
            style = "success";
        }
        else
        {
            message = result.Message;
            style = "danger";
        }
    }


}
