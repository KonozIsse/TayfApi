@page "/Categories"
<PageTitle>@SharedLocalize.GetLocalizedStringValue("categories") | @SharedLocalize.GetLocalizedStringValue("ControlPanel")</PageTitle>
<Alert Message="@message" Style="@style"></Alert>

<section class="content-header">
    <h1>  @SharedLocalize.GetLocalizedStringValue("categories") <small>@SharedLocalize.GetLocalizedStringValue("categories")</small> </h1>
    <ol class="breadcrumb">
        <li class="fa fa-dashboard">@SharedLocalize.GetLocalizedStringValue("dashboard")</li>
        <li class="active"> @SharedLocalize.GetLocalizedStringValue("categories") </li>
    </ol>
</section>

<!--  content -->
 @if (Model != null)
{
    if (user != null)
    {
        <section class="content">
            <!-- Info boxes -->
            <!-- /.row -->
            <div class="row">
                <div class="col-md-12">
                    <div class="box">
                        <div class="box-header">
                            <div class="box-header">
                                <div class="col-lg-6 form-inline" id="contact-form">
                                    <form class="registration" method="get">
                                        <div class="input-group-form search-panel ">
                                            <select type="button" class="btn btn-default dropdown-toggle form-control" data-toggle="dropdown" >
                                                <option value="-1" selected="" disabled="" hidden="">@SharedLocalize.GetLocalizedStringValue("FilterBy")</option>
                                                <option value="0">@SharedLocalize.GetLocalizedStringValue("Name")</option>
                                            </select>
                                            <input type="text" class="form-control input-group-form" placeholder="@SharedLocalize.GetLocalizedStringValue("search")" @bind-value="@search" />
                                            <button type="button" class="btn btn-primary" @onclick="@GethMainCategories"><i class="oi oi-magnifying-glass"></i></button>
                                            <a onClick="window.location.reload()" type="button" style="display:inline-block; width: auto; margin-top: 0;" class="btn btn-default"><i class="fa fa-refresh"></i></a>

                                        </div>
                                    </form>
                                    <div class="col-lg-4 form-inline" id="contact-form12"></div>
                                </div>
                                @if (user.UserType == UserType.Admin)
                                {
                                    <div class="box-tools pull-right">
                                        <a href="/Categories/Add" type="button" style="display:inline-block; width: auto; margin-top: 0;" class="btn btn-block btn-primary">@SharedLocalize.GetLocalizedStringValue("addcategory")</a>

                                    </div>
                                }
                            </div>

                        </div>

                        <!-- /.box-header -->
                        <div class="box-body">
                            <div class="row">
                                <div class="col-xs-12">
                                </div>
                            </div>


                            <div class="row">
                                <div class="col-xs-12 table-responsive">
                                    @if (Model.Count() > 0)
                                    {
                                        <table id="example1" class="table table-bordered table-striped">
                                            <thead>
                                                <tr>
                                                    <th> #</th>
                                                    <th>@SharedLocalize.GetLocalizedStringValue("Name")</th>
                                                    <th style="width: 30%;">@SharedLocalize.GetLocalizedStringValue("img")</th>
                                                    <th>@SharedLocalize.GetLocalizedStringValue("AddedDate")/@SharedLocalize.GetLocalizedStringValue("updateDate")</th>
                                                    <th>@SharedLocalize.GetLocalizedStringValue("status")</th>
                                                    @if (user.UserType == UserType.Admin)
                                                    {
                                                        <th>@SharedLocalize.GetLocalizedStringValue("Actions")</th>
                                                    }
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @{
                                                    var i = 0;
                                                }
                                                @foreach (var item in Model)
                                                {
                                                    i += 1;
                                                    <tr>
                                                        <td>@i</td>
                                                        <td>@item.CategoryName</td>
                                                        <td><img style="width: 20%;" src="@item.ImageId" /></td>
                                                        <td>
                                                            @SharedLocalize.GetLocalizedStringValue("AddedDate") : @item.CreatedAt <br />
                                                            @SharedLocalize.GetLocalizedStringValue("updateDate") : @item.UpdatedAt

                                                        </td>
                                                        <td>

                                                            <span class="label label-success">@(
                                                item.IsStatus == "Active" ? SharedLocalize.GetLocalizedStringValue("active") : SharedLocalize.GetLocalizedStringValue("notActive")
                                                ) </span>

                                                        </td>
                                                        @if (user.UserType == UserType.Admin)
                                                        {
                                                            <td>
                                                                <a data-toggle="tooltip" data-placement="bottom" title=" @item.CategoryName" href="/Categories/SubCategories/@item.Id"  class="badge bg-light-blue">@SharedLocalize.GetLocalizedStringValue("SubCategories")</a>
                                                                <a data-toggle="tooltip" data-placement="bottom" title=" @item.CategoryName"  href="/Categories/Edit/@item.Id"  class="badge bg-light-blue"><i class="fa fa-pencil-square-o" aria-hidden="true"></i></a>
                                                                <a data-toggle="tooltip" data-placement="bottom" title=" @item.CategoryName" @onclick="(async()=>await Delete(item.Id))" class="badge bg-red "><i class="fa fa-trash" aria-hidden="true"></i></a>
                                                            </td>
                                                        }
                                                        else
                                                        {
                                                            <td>
                                                                <a data-toggle="tooltip" data-placement="bottom" title=" @item.CategoryName" href="/Categories/SubCategories/@item.Id" class="badge bg-light-blue">@SharedLocalize.GetLocalizedStringValue("SubCategories")</a>
                                                            </td>
                                                        }
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    }
                                    else
                                    {
                                        <div class="col-xs-12 @(lang == "ar"?"text-right":"text-left")">
                                            @SharedLocalize.GetLocalizedStringValue("NoRecordfound").
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                        <!-- /.box-body -->
                    </div>
                    <!-- /.box -->
                </div>
                <!-- /.col -->
            </div>
            @if (Model.Count >= 10)
            {
                <Pagination MetaData="MetaData" Spread="2" SelectedPage="SelectedPage" />
            }
        </section>
    }
}
@code {
    string message = "";
    string style = "";
    [Parameter]
    public string search { get; set; }
    public string lang { get; set; }
    public string filter { get; set; }
    public MetaData MetaData { get; set; } = new MetaData();
    private PostsParameters _PostsParameters = new PostsParameters();
    public List<CategoryDto> Model { get; set; } 
    public AdminDto user { get; set; }
    protected override async Task OnInitializedAsync()
    {
        http.DefaultRequestHeaders.Add("Accept", "application/json");
        lang = await http.GetFromJsonAsync<string>("api/Language/GetDefaultLanugage");
        user = await http.GetFromJsonAsync<AdminDto>("api/Account/currentUser");
        await GethMainCategories();
    }
    private async Task SelectedPage(int page)
    {
        _PostsParameters.PageNumber = page;
        await GethMainCategories();
    }
    async Task GethMainCategories()
    {
        var pagingResponse = await _productBL.GethMainCategoriesCP(search, lang, _PostsParameters);
        Model = pagingResponse.ToList();
        MetaData = pagingResponse.MetaData;
    }
    public async Task Delete(int id)
    {
        var confirm = await js.InvokeAsync<bool>("confirm", $"Are you sure ?");
        @if (confirm)
        {
            var result = await _productBL.DeleteCategory(id);

            if (result.Success)
            {
                message = result.Message;
                style = "success";
            }
            else
            {
                message = result.Message;
                style = "danger";
            }
        }
        NavigationManager.NavigateTo("/Categories", true);
    }
   
   

}
