@page "/Option/Edit/{Id:int}"

<PageTitle>@SharedLocalize.GetLocalizedStringValue("editOption") | @SharedLocalize.GetLocalizedStringValue("ControlPanel")</PageTitle>
<Alert Message="@message" Style="@style"></Alert>
    <section class="content-header">
    <h1>@SharedLocalize.GetLocalizedStringValue("Options")<small>@SharedLocalize.GetLocalizedStringValue("editOption")</small> </h1>
    <ol class="breadcrumb">
        <li class = "fa fa-dashboard">@SharedLocalize.GetLocalizedStringValue("dashboard")</li>
        <li class = "fa fa-users">@SharedLocalize.GetLocalizedStringValue("Options")</li>
        <li class="active">@SharedLocalize.GetLocalizedStringValue("editOption")</li>
    </ol>
</section>

<!-- Main content -->
<section class="content">
    <!-- Info boxes -->
    <!-- /.row -->

    <div class="row">
        <div class="col-md-12">
            <div class="box">
                <div class="box-header">
                    <h3 class="box-title">@SharedLocalize.GetLocalizedStringValue("editOption")</h3>
                </div>

                <!-- /.box-header -->
                <div class="box-body">
                    <div class="row">
                        <div class="col-xs-12">
                            <div class="box box-info">
                                <br>
                                <EditForm Model="create" OnValidSubmit="UpdateOption">
                                    <div class="form-horizontal">
                                        <div class="box-body">

                                            <div class="box-body">
                                                <div class="form-group">
                                                        <label class="col-sm-2 col-md-3 control-label">@SharedLocalize.GetLocalizedStringValue("Name")  <span style="color:red;">*</span> </label>
                                                        <div class="col-md-8">
                                                            <InputText @bind-Value="create.OptionName" class="form-control" />
                                                        </div>
                                                    </div>
                                                <div class="form-group">
                                                    <label class="col-sm-2 col-md-3 control-label">@SharedLocalize.GetLocalizedStringValue("type") (for mobile)</label>
                                                    <div class="col-sm-10 col-md-4">
                                                        <InputSelect class="form-control" @bind-Value="create.OptionType">
                                                            <option value="@OptionType.Color">Color</option>
                                                            <option value="@OptionType.Radio">Radio</option>
                                                        </InputSelect>
                                                        <span class="help-block" style="font-weight: normal;font-size: 11px;margin-bottom: 0;">
                                                            @SharedLocalize.GetLocalizedStringValue("chooseCat")
                                                        </span>
                                                    </div>
                                                </div>

                                                <div class="box-footer text-center">
                                                    <button type="submit" class="btn btn-primary">@SharedLocalize.GetLocalizedStringValue("Submit")</button>
                                                   <a class = "btn btn-defult" href="/Options"> @SharedLocalize.GetLocalizedStringValue("back")</a>
                                                </div>

                                            </div>

                                        </div>

                                    </div>
                                </EditForm>
                            </div>

                        </div>
                        <!-- /.box-body -->
                    </div>
                    <!-- /.box -->
                </div>
                <!-- /.col -->
            </div>
        </div>
    </div>

</section>
@code {
    [Parameter]
    public int Id { get; set; }
    public string lang { get; set; }
    UpdateOptionDto create = new UpdateOptionDto();
    string message;
    string style;
    protected override async Task OnInitializedAsync()
    {
        create = new UpdateOptionDto();
        create = await _productBL.GetEditOption(Id);
        http.DefaultRequestHeaders.Add("Accept", "application/json");
        lang = await http.GetFromJsonAsync<string>("api/Language/GetDefaultLanugage");

    }

    async Task UpdateOption()
    {
        create.Id = Id;
        var result = await _productBL.EditOption(create);
        if (result.Success)
        {
            message = result.Message;
            style = "success";
        }
        else
        {
            message = result.Message;
            style = "danger";
        }
    }
}
