@page "/Value/Edit/{Id:int}"

<PageTitle>@SharedLocalize.GetLocalizedStringValue("editOption") | @SharedLocalize.GetLocalizedStringValue("ControlPanel")</PageTitle>
<Alert Message="@message" Style="@style"></Alert>
<section class="content-header">
    <h1>@SharedLocalize.GetLocalizedStringValue("Options")<small>@SharedLocalize.GetLocalizedStringValue("editOption")</small> </h1>
    <ol class="breadcrumb">

        <li class="fa fa-dashboard">@SharedLocalize.GetLocalizedStringValue("dashboard")</li>
        <li class="fa fa-users">@SharedLocalize.GetLocalizedStringValue("Options")</li>
        <li class="active">@SharedLocalize.GetLocalizedStringValue("editOption")</li>
    </ol>
</section>

<!-- Main content -->
<section class="content">
    <div class="row">
        <div class="col-md-12">
            <div class="box">
                <div class="box-header">
                    <h3 class="box-title">@SharedLocalize.GetLocalizedStringValue("editOption")</h3>
                </div>
                <div class="box-body">
                    <div class="row">
                        <div class="col-xs-12">
                            <div class="box box-info">
                                <br>
                                    <div class="form-horizontal">
                                        <div class="box-body">
                                       
                                        <div class="form-group">
                                            <label class="col-sm-2 col-md-3 control-label">@SharedLocalize.GetLocalizedStringValue("Name")  <span style="color:red;">*</span> (ar)</label>
                                            <div class="col-md-4">
                                                <input @bind="create.OptionValueName" class="form-control" />
                                            </div>
                                        </div>
                                            @if (create.ValueHexModel != "" && create.ValueHexModel != null)
                                            {
                                                <div class="form-group">
                                                    <label class="col-sm-3 col-md-3 control-label">@SharedLocalize.GetLocalizedStringValue("PropertyColor")</label>
                                                    <div class="col-sm-4 col-md-4">
                                                        <input @bind="create.ValueHexModel" type = "color" class = "form-control" />

                                                    </div>
                                                </div>
                                            }
                                            <div class="box-footer text-center">
                                            <button type="submit" class="btn btn-primary" @onclick="UpdateOption">@SharedLocalize.GetLocalizedStringValue("Submit")</button>
                                                   <a class="btn btn-defult" href="/Options">@SharedLocalize.GetLocalizedStringValue("back")</a>
                                            </div>

                                        </div>

                                    </div>
                            </div>
                        </div>

                    </div>
                    <!-- /.box-body -->
                </div>
                <!-- /.box -->
            </div>
            <!-- /.col -->
        </div>
    </div>
    <!-- /.row -->
    <!-- Main row -->
    <!-- /.row -->
</section>
@code {
    [Parameter]
    public int Id { get; set; }
    public string lang { get; set; }
    UpdateValueDto create = new UpdateValueDto();
    string message;
    string style;
    protected override async Task OnInitializedAsync()
    {
        create = new UpdateValueDto();
        create = await _productBL.GetValueId(Id);
        http.DefaultRequestHeaders.Add("Accept", "application/json");
        lang = await http.GetFromJsonAsync<string>("api/Language/GetDefaultLanugage");

    }

    async Task UpdateOption()
    {
        create.Id = Id;
        var result = await _productBL.UpdateValue(create);
        if (result.Success)
        {
            message = result.Message;
            style = "success";
        }
        else
        {
            message = result.Message;
            style = "danger";
        }
    }
}
