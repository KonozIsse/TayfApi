@page "/Admin/AddRole"

<PageTitle>@SharedLocalize.GetLocalizedStringValue("AddAdminType") | @SharedLocalize.GetLocalizedStringValue("ControlPanel")</PageTitle>
<Alert Message="@message" Style="@style"></Alert>
<section class="content-header">
    <h1> @SharedLocalize.GetLocalizedStringValue("AddAdminType") <small>@SharedLocalize.GetLocalizedStringValue("AddAdminType")</small> </h1>
    <ol class="breadcrumb">
        <li class="fa fa-dashboard">@SharedLocalize.GetLocalizedStringValue("dashboard")</li>
        <li class="fa fa-users">@SharedLocalize.GetLocalizedStringValue("ManageRoles")</li>
        <li class="active">@SharedLocalize.GetLocalizedStringValue("AddAdminType")</li>
    </ol>
</section>

<!-- Main content -->
<section class="content">
    <!-- Info boxes -->
    <!-- /.row -->

    <div class="row">
        <div class="col-md-12">
            <div class="box">
                <div class="box-header">
                    <h3 class="box-title">@SharedLocalize.GetLocalizedStringValue("AddAdminType")</h3>
                </div>

                <!-- /.box-header -->
                <div class="box-body">
                    <div class="row">
                        <div class="col-xs-12">
                            <div class="box box-info">
                                <br>
                                    <div class="form-horizontal">
                                        <div class="box-body">
                                        <EditForm Model="create" OnValidSubmit="CreateRole">
                                                <div class="form-group">
                                                    <label class="col-sm-2 col-md-3 control-label">@SharedLocalize.GetLocalizedStringValue("AdminType") </label>
                                                    <div class="col-sm-10 col-md-4">
                                                        <InputText class="form-control field-validate" @bind-Value="create.Name"></InputText>
                                                    <ValidationMessage For="@(() => create.Name)" />
                                                        <span class="help-block" style="font-weight: normal;font-size: 11px;margin-bottom: 0;">@SharedLocalize.GetLocalizedStringValue("plzchooseType")</span>
                                                        <span class="help-block hidden">@SharedLocalize.GetLocalizedStringValue("Required")</span>
                                                    </div>
                                                </div>

                                                <div class="form-group">
                                                    <label class="col-sm-2 col-md-3 control-label">@SharedLocalize.GetLocalizedStringValue("status") </label>
                                                    <div class="col-sm-10 col-md-4">
                                                        <InputSelect class="form-control" @bind-Value="create.IsStatus">
                                                            <option value="@Status.Active">@SharedLocalize.GetLocalizedStringValue("active")</option>
                                                            <option value="@Status.NotActive">@SharedLocalize.GetLocalizedStringValue("notActive")</option>
                                                        </InputSelect>
                                                    <ValidationMessage For="@(() => create.IsStatus)" />
                                                        <span class="help-block" style="font-weight: normal;font-size: 11px;margin-bottom: 0;">
                                                            @SharedLocalize.GetLocalizedStringValue("chooseStatus")
                                                        </span>
                                                    </div>
                                                </div>

                                                <div class="form-group">
                                                    <label class="col-sm-2 col-md-3 control-label">@SharedLocalize.GetLocalizedStringValue("vendor") </label>
                                                    <div class="col-sm-10 col-md-4">
                                                        <InputSelect class="form-control" @bind-Value="create.IsVendorLink">
                                                            <option value="true">@SharedLocalize.GetLocalizedStringValue("Yes")</option>
                                                            <option value="false">@SharedLocalize.GetLocalizedStringValue("No")</option>
                                                        </InputSelect>
                                                    </div>
                                                </div>

                                                <!-- /.box-body -->
                                                <div class="box-footer text-center">
                                                    <button type="submit" class="btn btn-primary">@SharedLocalize.GetLocalizedStringValue("Submit")</button>
                                                <a class="btn btn-defult" href="/Roles">@SharedLocalize.GetLocalizedStringValue("back")</a>
                                                </div>
                                                <!-- /.box-footer -->
                                            </EditForm>
                                        </div>

                                    </div>
                                }
                            </div>
                        </div>

                    </div>
                    <!-- /.box-body -->
                </div>
                <!-- /.box -->
            </div>
            <!-- /.col -->
        </div>
    </div>
</section>
@code {
    [Parameter]
    public CreateRoleDto create { get; set; }
    protected override async Task OnInitializedAsync()
    {
        create = new CreateRoleDto();

    }
    string message = "";
    string style = "";
    async Task CreateRole()
    {
        var result = await _userBL.AddRole(create);
        if (result.Success)
        {
            message = result.Message;
            style = "success";
        }
        else
        {
            message = result.Message;
            style = "danger";
        }
    }
}