@page "/Roles"
<PageTitle>@SharedLocalize.GetLocalizedStringValue("ManageRoles") | @SharedLocalize.GetLocalizedStringValue("ControlPanel")</PageTitle>

<section class="content-header">
    <h1> @SharedLocalize.GetLocalizedStringValue("ManageRoles")<small>@SharedLocalize.GetLocalizedStringValue("ManageRoles")</small> </h1>
    <ol class="breadcrumb">
        <li class="fa fa-dashboard">@SharedLocalize.GetLocalizedStringValue("dashboard")</li>
        <li class="active">@SharedLocalize.GetLocalizedStringValue("ManageRoles")</li>
    </ol>
</section>

@if (Model != null)
{
    <section class="content">
        <!-- Info boxes -->
        <!-- /.row -->

        <div class="row">
            <div class="col-md-12">
                <div class="box">
                    <div class="box-header">
                        <h3 class="box-title">@SharedLocalize.GetLocalizedStringValue("ManageRoles")</h3>
                        <div class="box-tools pull-right">
                            <a href="/Admin/AddRole" type="button" class="btn btn-block btn-primary">@SharedLocalize.GetLocalizedStringValue("AddAdminType")</a>
                        </div>
                    </div>

                    <!-- /.box-header -->
                    <div class="box-body">
                        <div class="row">
                            <div class="col-xs-12">
                            </div>

                        </div>
                        <div class="row">
                            <div class="col-xs-12">
                                @if (Model.Count() > 0)
                                {
                                    <table id="example1" class="table table-bordered table-striped">
                                        <thead>
                                            <tr>
                                                <th>#</th>
                                                <th>@SharedLocalize.GetLocalizedStringValue("AdminType")</th>
                                                <th>@SharedLocalize.GetLocalizedStringValue("CreatedDate")</th>
                                                <th>@SharedLocalize.GetLocalizedStringValue("status")</th>
                                                <th>@SharedLocalize.GetLocalizedStringValue("ManageRoles")</th>
                                                <th>@SharedLocalize.GetLocalizedStringValue("Actions")</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @{
                                                var i = 0;
                                            }
                                            @foreach (var item in Model)
                                            {
                                                i += 1;
                                                <tr>
                                                    <td>@i</td>
                                                    <td>
                                                        @item.Name
                                                    </td>
                                                    <td>
                                                        <strong>@SharedLocalize.GetLocalizedStringValue("AddedDate"): </strong>@item.CreatedAt.ToString("MM/dd/yyyy hh:mm:ss tt")
                                            <br>
                                                        <strong>@SharedLocalize.GetLocalizedStringValue("updateDate"): </strong>@(!String.IsNullOrEmpty(item.UpdatedAt.ToString()) ? item.UpdatedAt.Value.AddHours(3).ToString("MM/dd/yyyy hh:mm:ss tt") : "")
                                            <br>
                                                    </td>
                                                    <td>
                                                        <strong class="badge bg-green">@(item.IsStatus == Status.Active ? SharedLocalize.GetLocalizedStringValue("active") : SharedLocalize.GetLocalizedStringValue("notActive")
                                                ) </strong>

                                                    </td>
                                                    <td>
                                                        <a href="/Admin/EditRole/@item.Id" class="manage-role-popup">@SharedLocalize.GetLocalizedStringValue("ManageRoles")</a>
                                                    </td>
                                                    <td>
                                                        <a data-toggle="tooltip" data-placement="bottom" href="/Admin/EditType/@item.Id " class="badge bg-light-blue"><i class="fa fa-pencil-square-o" aria-hidden="true"></i></a>

                                                    </td>


                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                }
                                else
                                {
                                    <div class="col-xs-12 text-right">
                                        @SharedLocalize.GetLocalizedStringValue("NoRecordfound").

                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                    <!-- /.box-body -->
                </div>
                <!-- /.box -->
            </div>
            <!-- /.col -->
        </div>


        <div class="modal fade" id="manageRoleModal" tabindex="-1" role="dialog" aria-labelledby="manageRoleModalLabel">
            <div class="modal-dialog" role="document">
                <div class="modal-content" id="manage-role-content">
                </div>
            </div>
        </div>

        <!-- Main row -->
        <!-- /.row -->
    </section>
}
@code {
    public List<RoleDto> Model { get; set; }

    protected override async Task OnInitializedAsync()
    {
        http.DefaultRequestHeaders.Add("Accept", "application/json");
        Model = await http.GetFromJsonAsync<List<RoleDto>>("api/Admin/get-roles");
    }
}
