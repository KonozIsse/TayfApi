@page "/CP/Admins"
<PageTitle>@SharedLocalize.GetLocalizedStringValue("admins") | @SharedLocalize.GetLocalizedStringValue("ControlPanel")</PageTitle>
<Alert Message="@message" Style="@style"></Alert>
@if (Model != null)
{
    <section class="content">
        <div class="row">
            <div class="col-md-12">
                <div class="box">
                    <div class="box-header">
                        <h3 class="box-title">@SharedLocalize.GetLocalizedStringValue("admins") </h3>
                        <div class="box-tools pull-right">
                            <a href="/CP/Admin/Add" type="button" class="btn btn-block btn-primary">@SharedLocalize.GetLocalizedStringValue("AddAdmins")</a>
                        </div>
                    </div>

                    <!-- /.box-header -->
                    <div class="box-body">
                        <div class="row">
                            <div class="col-xs-12">
                            </div>

                        </div>
                        <div class="row">
                            <div class="col-xs-12 table-responsive">
                                @if (Model.Count() > 0)
                                {
                                    <table id="example1" class="table table-bordered table-striped">
                                        <thead>
                                            <tr>
                                                <th>#</th>
                                                <th>@SharedLocalize.GetLocalizedStringValue("FullName")</th>
                                                <th>@SharedLocalize.GetLocalizedStringValue("Email")</th>
                                                <th>@SharedLocalize.GetLocalizedStringValue("AdminType")</th>
                                                <th>@SharedLocalize.GetLocalizedStringValue("status")</th>
                                                <th>@SharedLocalize.GetLocalizedStringValue("Actions")</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @{
                                                var i = 0;
                                            }
                                            @foreach (var item in Model)
                                            {
                                                i += 1;
                                                <tr>
                                                    <td>@i</td>
                                                    <td>
                                                        @item.FullName
                                                    </td>
                                                    <td>
                                                        @item.Email
                                                    </td>
                                                    <td>
                                                        <strong class="badge bg-light-blue">
                                                            @item.RoleName
                                                        </strong>
                                                    </td>
                                                    <td>
                                                        <strong class="badge bg-green">@item.Status </strong>

                                                    </td>

                                                    <td>

                                                        <a data-toggle="tooltip" data-placement="bottom" title=" @SharedLocalize.GetLocalizedStringValue("edit")" href="/CP/Admin/Edit/@item.Id " class="badge bg-light-blue"><i class="fa fa-pencil-square-o" aria-hidden="true"></i></a>
                                                        @if (item.UserType != UserType.Admin)
                                                        {
                                                            <a title="@SharedLocalize.GetLocalizedStringValue("delete")" @onclick="(async ()=> await Delete(item))" class="badge bg-red"> <i class="fa fa-trash" aria-hidden="true"></i> </a>
                                                        }
                                                    </td>


                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                }
                                else
                                {
                                    <div class="col-xs-12 @(lang == "ar"?"text-right":"text-left")">
                                        @SharedLocalize.GetLocalizedStringValue("NoRecordfound").
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                    <!-- /.box-body -->
                </div>
                <!-- /.box -->
            </div>
            <!-- /.col -->
        </div>

        <!-- /.row -->

        <div class="modal fade" id="notificationModal" tabindex="-1" role="dialog" aria-labelledby="notificationModalLabel">
            <div class="modal-dialog" role="document">
                <div class="modal-content notificationContent">
                </div>
            </div>
        </div>

        <!-- Main row -->
        <!-- /.row -->
    </section>
}
@code {

    string lang = "en";
    string message = "";
    string style = "";
    public List<AdminDto> Model { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Model = await http.GetFromJsonAsync<List<AdminDto>>("api/Admin/get-admins-stores");
    }
    async Task Delete(AdminDto admin)
    {
        var confirm = await js.InvokeAsync<bool>("confirm", "Are you sure ?");
        if (confirm)
        {
            var response = await http.DeleteAsync($"api/Admin/remove-admin/{admin.Id}");

            if (response.IsSuccessStatusCode)
            {
                var model = await response.Content.ReadAsAsync<BussnessResultModel>();
                if (model.Success)
                {
                    message = "success";//model.Message;
                    style = "success";
                }
                else
                {
                    message = "fail";
                    style = "danger";
                }
            }
        }
       
       // NevigateToYourUrl();
    }
    void NevigateToYourUrl()
    {
        NavigationManager.NavigateTo("/CP/Admins", true);
    }
}

