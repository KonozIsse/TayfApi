@page "/zone/edit"
@page "/zone/edit/{id:int}"
@inject LocationTaxBL _locationTaxBL
@inject LocService SharedLocalize
@inject NavigationManager _navigationManager

<PageTitle>@SharedLocalize.GetLocalizedStringValue("RegionsEdit")| @SharedLocalize.GetLocalizedStringValue("ControlPanel")</PageTitle>
<Alert Message="@message" Style="@style"></Alert>

<section class="content-header">
    <h1>@SharedLocalize.GetLocalizedStringValue("Regions")<small>@SharedLocalize.GetLocalizedStringValue("RegionsEdit")</small> </h1>
    <ol class="breadcrumb">
        <li class="fa fa-dashboard"> @SharedLocalize.GetLocalizedStringValue("dashboard")</li>
        <li class="fa fa-users">@SharedLocalize.GetLocalizedStringValue("Regions")</li>
         <li class="active">@SharedLocalize.GetLocalizedStringValue("RegionsEdit")</li>
    </ol>
</section>

<!-- Main content -->
<section class="content">
    <!-- Info boxes -->
    <!-- /.row -->

    <div class="row">
        <div class="col-md-12">
            <div class="box">
                <div class="box-header">
                    <h3 class="box-title">@SharedLocalize.GetLocalizedStringValue("RegionsEdit")</h3>
                </div>

                <!-- /.box-header -->
                <div class="box-body">
                    <div class="row">
                        <div class="col-xs-12">
                            <div class="box box-info">
                                <br>
                                <EditForm Model="@create" OnValidSubmit="@UpdateZone">
                                    <DataAnnotationsValidator />
                                    <ValidationSummary />
                                    <div class="form-horizontal">

                                        <!-- form start -->
                                        <div class="box-body">
                                            <div class="form-group">
                                                <div class="form-group">
                                                    <label class="col-sm-2 col-md-3 control-label">@SharedLocalize.GetLocalizedStringValue("Country")</label>
                                                    <div class="col-sm-10 col-md-4">
                                                        <InputSelect class="form-control" @bind-Value="create.CountryId">
                                                            @if(countries == null)
                                                            {
                                                                <p>Loading</p>
                                                            }
                                                            else
                                                            {
                                                                <option value="">Select Country ...</option>
                                                                @foreach (var country in countries)
                                                                {
                                                                    <option value="@country.Id">@country.CountryName</option>
                                                                }
                                                            }
                                                        </InputSelect>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="form-group">
                                                <label class="col-sm-2 col-md-3 control-label">
                                                    @SharedLocalize.GetLocalizedStringValue("RegionName")<span style="color:red;">*</span>
                                                </label>
                                                <div class="col-sm-10 col-md-4">
                                                    <InputText class="form-control" @bind-Value="create.ZoneName" />
                                                </div>
                                            </div>

                                            <div class="form-group">
                                                <label class="col-sm-2 col-md-3 control-label">
                                                    @SharedLocalize.GetLocalizedStringValue("RegionCode")<span style="color:red;"></span>
                                                </label>
                                                <div class="col-sm-10 col-md-4">
                                                    <InputText class="form-control" @bind-Value="create.ZoneCode" />
                                                </div>
                                            </div>


                                            <div class="box-footer text-center">
                                                <button type="submit" class="btn btn-primary">@SharedLocalize.GetLocalizedStringValue("Submit")</button>
                                                <a href="/zone/Index" type="submit" class="btn btn-defult">@SharedLocalize.GetLocalizedStringValue("back")</a>
                                            </div>

                                        </div>

                                    </div>
                                </EditForm>
                            </div>
                        </div>

                    </div>
                    <!-- /.box-body -->
                </div>
                <!-- /.box -->
            </div>
            <!-- /.col -->
        </div>
    </div>

</section>


@code {
    [Parameter]
    public int id { get; set; }
    UpdateZoneDto create = new UpdateZoneDto();
    private List<CountryDto> countries;
    string message;
    string style;
    protected override async Task OnInitializedAsync()
    {
        create = new UpdateZoneDto();
        if(id != 0)
        {
            create = await _locationTaxBL.GetZonett(id);
        }
        countries = await _locationTaxBL.GetAllCountries();
    }

    async Task UpdateZone()
    {
       var result = await _locationTaxBL.EditZone(id,create);
        if (result.Success)
        {
            message = result.Message;
            style = "success";
        }
        else
        {
            message = result.Message;
            style = "danger";
        }
    }
}
