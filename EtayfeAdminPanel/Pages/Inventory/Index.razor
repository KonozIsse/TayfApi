@page "/Stocks"

<PageTitle>@SharedLocalize.GetLocalizedStringValue("inventory")|@SharedLocalize.GetLocalizedStringValue("ControlPanel")</PageTitle>


<section class="content-header">
    <h1>  @SharedLocalize.GetLocalizedStringValue("inventory") <small>@SharedLocalize.GetLocalizedStringValue("inventory").</small> </h1>
    <ol class="breadcrumb">
        <li class="fa fa-dashboard">@SharedLocalize.GetLocalizedStringValue("dashboard")</li>
        <li class="fa fa-users">@SharedLocalize.GetLocalizedStringValue("products")</li>
        <li class="active"> @SharedLocalize.GetLocalizedStringValue("inventory") </li>
    </ol>
</section>
<Alert Message="@message" Style="@style"></Alert>
<!-- Main content -->
<section class="content">
    <!-- Info boxes -->
    <!-- /.row -->
    <div class="row">
        <div class="col-md-12">
            <div class="box">
                <div class="box-header">
                    <h3 class="box-title">@SharedLocalize.GetLocalizedStringValue("AddInventory") </h3>

                </div>
                <div class="box-body">

                    
                     
                    <div class="row">
                        <div class="col-xs-12">
                            <div class="box box-info">
                                <!-- form start -->
                                <div class="box-body">

                                    <div class="row">
                                        <!-- Left col -->
                                        <div class="col-md-6">
                                            <!-- MAP & BOX PANE -->
                                            <!-- /.box -->
                                            <div class="row">
                                                <!-- /.col -->
                                                <div class="col-md-12">
                                                    <!-- USERS LIST -->
                                                    <div class="box box-info">
                                                        <div class="box-header with-border">
                                                            <h3 class="box-title"> @SharedLocalize.GetLocalizedStringValue("AddStock")</h3>
                                                            <div class="box-tools pull-right">
                                                            </div>
                                                        </div>
                                                        
                                                        <!-- /.box-header -->
                                                        <div class="box-body">
                                                            <EditForm Model="create" OnValidSubmit="Add">
                                                         <DataAnnotationsValidator />
                                                            <div class="form-horizontal">
                                                                    <div class="form-group">
                                                                        <label class="col-sm-2 col-md-4 control-label">@SharedLocalize.GetLocalizedStringValue("products")<span style="color:red;">*</span> </label>
                                                                        <div class="col-sm-10 col-md-8">
                                                                            <InputSelect  @bind-Value="create.ProductId" class="form-control select2 select2-hidden-accessible" aria-hidden="true">
                                                                                <option value="">@SharedLocalize.GetLocalizedStringValue("ProductName")</option>
                                                                                    @if (products != null)
                                                                                    {
                                                                                        @foreach (var c in products)
                                                                                        {
                                                                                            <option  value="@c.Id">@c.ProductName</option>
                                                                                        }
                                                                                    }
                                                                            </InputSelect>
                                                                                <ValidationMessage For="@(() => create.ProductId)" />
                                                                        </div>
                                                                    </div>
                                                                    <div class="form-group">
                                                                        
                                                                        @if (create.ProductId != 0)
                                                                        {
                                                                            attributes = attributes.Where(c => c.ProductId == create.ProductId).ToList();
                                                                            @if (attributes != null)
                                                                            {
                                                                                <label  class="col-sm-2 col-md-4 control-label">@SharedLocalize.GetLocalizedStringValue("ProductAttributes")</label>
                                                                                <div class="col-sm-10 col-md-8">
                                                                                    <ul class="list-group list-group-root well list-group-root2" >
                                                                                        @{
                                                                                            int i = 0;
                                                                                            var distinct = attributes.GroupBy(c => c.OptionId).Select(g => g.First()).ToList(); 
                                                                                            foreach (var t in distinct)
                                                                                            {
                                                                                                i += 1;
                                                                                                var opt = attributes.Where(r => r.OptionId == t.OptionId).ToList();
                                                                                                <li href="#" class="list-group-item">
                                                                                                    <label style="width:100%">
                                                                                                        <input type="hidden" class="attributeid_4"  value="@t.OptionId">
                                                                                                        @t.Option
                                                                                                    </label>
                                                                                                </li>
                                                                                                <ul class="list-group">
                                                                                                    <li class="list-group-item">
                                                                                                        @foreach(var v in opt)
                                                                                                        {
                                                                                                            <label class="nn">
                                                                                                                <input name="values_@t.OptionId" @onclick="(()=> AddAttributs(v.Id))" value="@t.ValueId" required type="radio" class="currentstock required_one"> @v.Value
                                                                                                            </label>
                                                                                                        }
                                                                                                    </li>
                                                                                                </ul>
                                                                                            }
                                                                                        }
                                                                                    </ul>
                                                                                    <span class="help-block" style="font-weight: normal;font-size: 11px;margin-bottom: 0;">
                                                                                        @SharedLocalize.GetLocalizedStringValue("SelectAttrs")
                                                                                    </span>
                                                                                    <span class="help-block hidden">@SharedLocalize.GetLocalizedStringValue("plzAddAttrs")</span>
                                                                                </div>
                                                                            }
                                                                        }
                                                                    </div>
                                                                    <div class="form-group">
                                                                        <label class="col-sm-2 col-md-4 control-label">
                                                                            @SharedLocalize.GetLocalizedStringValue("stock")
                                                                        </label>
                                                                        <div class="col-sm-10 col-md-8">
                                                                            <InputNumber class="form-control" style="width:100%" @bind-Value="create.Stock" />
                                                                                <ValidationMessage For="@(() => create.Stock)" />
                                                                        </div>
                                                                    </div>

                                                                    <div class="form-group">
                                                                        <label class="col-sm-2 col-md-4 control-label">
                                                                            @SharedLocalize.GetLocalizedStringValue("AvailableStock")
                                                                        </label>
                                                                        <div class="col-sm-10 col-md-8">
                                                                            <input disabled class="form-control" style="width:100%" value="@(_productBL.AvailabilityProducts(create.ProductId))" />
                                                                        </div>
                                                                    </div>
                                                                    <div class="form-group">
                                                                        <label class="col-sm-2 col-md-4 control-label">@SharedLocalize.GetLocalizedStringValue("PurchaseCode")</label>
                                                                        <div class="col-sm-10 col-md-8">
                                                                                <InputText class="form-control" @bind-Value="@create.PurchaseCode"></InputText>
                                                                        </div>
                                                                    </div>
                                                                    <div class="box-footer text-center">
                                                                            <button type="button" class="btn btn-primary pull-right" @onclick="Add">@SharedLocalize.GetLocalizedStringValue("AddStock")</button>
                                                                    </div>
                                                            </div>
                                                            </EditForm>
                                                        </div>
                                                      
                                                    </div>

                                                    <!-- /.col -->
                                                </div>
                                                <!-- /.row -->
                                            </div>
                                            <div class="box-footer col-xs-12">
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                  
                </div>
                <!-- /.box-body -->
            </div>
            <!-- /.box -->
        </div>
    </div>
</section>
@code {
    public CreateInventoryDto create { get; set; }
    public List<ProductDto> products { get; set; }
    public AdminDto user { get; set; }
    
    public List<AttributeDto> attributes { get; set; }
    protected override async Task OnInitializedAsync()
    {
        create = new CreateInventoryDto();
        http.DefaultRequestHeaders.Add("Accept", "application/json");
        user = await http.GetFromJsonAsync<AdminDto>("api/Account/currentUser");
        products = await _productBL.GetAllActiveProducts(); 
        attributes = await _productBL.GetAttributs();
       
    }
    string message = "";
    string style = "";
    async Task Add()
    {
        var result = await _productBL.AddInventory(user.Id, create);
        if (result.Success)
        {
            message = result.Message;
            style = "success";
        }
        else
        {
            message = result.Message;
            style = "danger";
        }
    }
    public void AddAttributs(int id)
    {
        create.AttributesProductId = id;
    }
}
