@page "/Stocks"

<PageTitle>@SharedLocalize.GetLocalizedStringValue("EditEmailMessage")|@SharedLocalize.GetLocalizedStringValue("ControlPanel")</PageTitle>

<Alert Message="@message" Style="@style"></Alert>
<section class="content-header">
    <h1>  @SharedLocalize.GetLocalizedStringValue("inventory") <small>@SharedLocalize.GetLocalizedStringValue("inventory").</small> </h1>
    <ol class="breadcrumb">
        <li class="fa fa-dashboard">@SharedLocalize.GetLocalizedStringValue("dashboard")</li>
        <li class="fa fa-users">@SharedLocalize.GetLocalizedStringValue("products")</li>
        <li class="active"> @SharedLocalize.GetLocalizedStringValue("inventory") </li>
    </ol>
</section>

<!-- Main content -->
<section class="content">
    <!-- Info boxes -->
    <!-- /.row -->
    <div class="row">
        <div class="col-md-12">
            <div class="box">
                <div class="box-header">
                    <h3 class="box-title">@SharedLocalize.GetLocalizedStringValue("AddInventory") </h3>

                </div>
                <div class="box-body">

                    
                     
                    <div class="row">
                        <div class="col-xs-12">
                            <div class="box box-info">
                                <!-- form start -->
                                <div class="box-body">

                                    <div class="row">
                                        <!-- Left col -->
                                        <div class="col-md-6">
                                            <!-- MAP & BOX PANE -->
                                            <!-- /.box -->
                                            <div class="row">
                                                <!-- /.col -->
                                                <div class="col-md-12">
                                                    <!-- USERS LIST -->
                                                    <div class="box box-info">
                                                        <div class="box-header with-border">
                                                            <h3 class="box-title"> @SharedLocalize.GetLocalizedStringValue("AddStock")</h3>
                                                            <div class="box-tools pull-right">
                                                            </div>
                                                        </div>
                                                        <EditForm Model="@create" OnValidSubmit="@AddInventory">
                                                         <DataAnnotationsValidator />
                                                        <!-- /.box-header -->
                                                        <div class="box-body">

                                                            <div class="form-horizontal">

                                                                <form class="form-horizontal form-validate">
                                                                    <div class="form-group">
                                                                        <label class="col-sm-2 col-md-4 control-label">@SharedLocalize.GetLocalizedStringValue("products")<span style="color:red;">*</span> </label>
                                                                        <div class="col-sm-10 col-md-8">
                                                                            <InputSelect  @bind-Value="create.ProductId" class="form-control select2 select2-hidden-accessible" aria-hidden="true">
                                                                                <option value="">@SharedLocalize.GetLocalizedStringValue("ProductName")</option>
                                                                                    @if (products != null)
                                                                                    {
                                                                                        @foreach (var c in products)
                                                                                        {
                                                                                            <option value="@c.Id">@c.ProductName</option>
                                                                                        }
                                                                                    }
                                                                            </InputSelect>
                                                                                <ValidationMessage For="@(() => create.ProductId)" />
                                                                        </div>
                                                                    </div>
                                                                        <div >

                                                                            @if (attributes != null)
                                                                            {
                                                                                <div class="form-group">
                                                                                    <label for="name" class="col-sm-2 col-md-4 control-label">@SharedLocalize.GetLocalizedStringValue("ProductAttributes")</label>
                                                                                    <div class="col-sm-10 col-md-8">
                                                                                        <ul class="list-group list-group-root well list-group-root2">
                                                                                            @{
                                                                                                int i = 0;
                                                                                                var inp = "";

                                                                                                foreach (var t in attributes)
                                                                                                {
                                                                                                    i += 1;
                                                                                                    var opt = attributes.Where(r => r.OptionId == t.OptionId).ToList();
                                                                                                    <li href="#" class="list-group-item">
                                                                                                        <label style="width:100%">
                                                                                                            <input type="hidden" class="attributeid_4" name="attributes" value="@t.OptionId">
                                                                                                            @t.Option
                                                                                                        </label>
                                                                                                    </li>
                                                                                                    <ul class="list-group">
                                                                                                        <li class="list-group-item">
                                                                                                           
                                                                                                            @foreach (var p in opt)
                                                                                                            {
                                                                                                                <label class="nn">
                                                                                                                    <input name="values_@t.OptionId"  Id="@p.Id" value="@p.OptionId" required type="radio" class="currentstock required_one"> @t.Value
                                                                                                                </label>
                                                                                                            }
                                                                                                        </li>
                                                                                                    </ul>
                                                                                                }
                                                                                            }
                                                                                        </ul>
                                                                                        <span class="help-block" style="font-weight: normal;font-size: 11px;margin-bottom: 0;">
                                                                                            @SharedLocalize.GetLocalizedStringValue("SelectAttrs")
                                                                                        </span>
                                                                                        <span class="help-block hidden">@SharedLocalize.GetLocalizedStringValue("plzAddAttrs")</span>
                                                                                    </div>
                                                                                </div>
                                                                            }

                                                                        </div>
                                                                    <div class="form-group">
                                                                        <label class="col-sm-2 col-md-4 control-label">
                                                                            @SharedLocalize.GetLocalizedStringValue("stock")
                                                                        </label>
                                                                        <div class="col-sm-10 col-md-8">
                                                                            <InputNumber class="form-control" style="width:100%" @bind-Value="create.Stock" />
                                                                                <ValidationMessage For="@(() => create.Stock)" />
                                                                        </div>
                                                                    </div>
                                                                    <div class="form-group">
                                                                        <label class="col-sm-2 col-md-4 control-label">@SharedLocalize.GetLocalizedStringValue("ReferenceORPurchaseCode")</label>
                                                                        <div class="col-sm-10 col-md-8">
                                                                                <InputText class="form-control" @bind-Value="@create.PurchaseCode"></InputText>
                                                                        </div>
                                                                    </div>
                                                                    <div class="box-footer text-center">
                                                                            <button type="button" id="attribute-btn" class="btn btn-primary pull-right ds">@SharedLocalize.GetLocalizedStringValue("AddStock")</button>
                                                                    </div>

                                                                </form>
                                                            </div>
                                                        </div>
                                                        </EditForm>
                                                    </div>

                                                    <!-- /.col -->
                                                </div>
                                                <!-- /.row -->
                                            </div>
                                            <div class="box-footer col-xs-12">
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                  
                </div>
                <!-- /.box-body -->
            </div>
            <!-- /.box -->
        </div>
    </div>
</section>
@code {
    public CreateInventoryDto create { get; set; }
    private List<ProductDto> products;
    private List<AttributeDto> attributes;
    protected override async Task OnInitializedAsync()
    {
        create = new CreateInventoryDto();
        products = await _productBL.GetAllActiveProducts(); 
        attributes = await _productBL.GetAttributsProducts(create.ProductId);
    }
    string message = "";
    string style = "";
    async Task AddInventory()
    {
        var result = await _productBL.AddInventory(3,create);
        if (result.Success)
        {
            message = result.Message;
            style = "success";
        }
        else
        {
            message = result.Message;
            style = "danger";
        }
    }
}
