@page "/Taxes/Add"
<PageTitle>@SharedLocalize.GetLocalizedStringValue("addtaxes") | @SharedLocalize.GetLocalizedStringValue("ControlPanel")</PageTitle>
<Alert Message="@message" Style="@style"></Alert>

<section class="content-header">
    <h1>@SharedLocalize.GetLocalizedStringValue("taxclass")<small>@SharedLocalize.GetLocalizedStringValue("addtaxes")</small> </h1>
    <ol class="breadcrumb">
        <li class="fa fa-dashboard">@SharedLocalize.GetLocalizedStringValue("dashboard")</li>
        <li class="fa fa-users">@SharedLocalize.GetLocalizedStringValue("taxclass")</li>

        <li class="active">@SharedLocalize.GetLocalizedStringValue("addtaxes")</li>
    </ol>
</section>

<!-- Main content -->
<section class="content">
    <!-- Info boxes -->
    <!-- /.row -->

    <div class="row">
        <div class="col-md-12">
            <div class="box">
                <div class="box-header">
                    <h3 class="box-title">@SharedLocalize.GetLocalizedStringValue("addtaxes")</h3>
                </div>

                <!-- /.box-header -->
                <div class="box-body">
                    <div class="row">
                        <div class="col-xs-12">
                            <div class="box box-info">
                                <br>
                                <EditForm Model="@create" OnValidSubmit="@AddTaxClass">
                                        <DataAnnotationsValidator />
                                    <div class="form-horizontal">
                                        <div class="box-body">
                                            <div class="form-group">
                                                <label class="col-sm-2 col-md-3 control-label">
                                                    @SharedLocalize.GetLocalizedStringValue("title")<span style="color:red;">*</span>

                                                </label>
                                                <div class="col-sm-10 col-md-4">
                                                    <InputText class="form-control" @bind-Value="create.Title" />
                                                    <ValidationMessage For="@(() => create.Title)" />
                                                </div>
                                            </div>



                                            <div class="form-group">
                                                <label class="col-sm-2 col-md-3 control-label">
                                                    @SharedLocalize.GetLocalizedStringValue("desc")
                                                </label>
                                                <div class="col-sm-10 col-md-4">
                                                    <InputText class="form-control" @bind-Value="create.Description" />
                                                    <ValidationMessage For="@(() => create.Description)" />
                                                </div>
                                            </div>



                                            <div class="box-footer text-center">
                                                <button type="submit" class="btn btn-primary">@SharedLocalize.GetLocalizedStringValue("Submit")</button>
                                                <a href="/Taxes" type="submit" class="btn btn-defult">@SharedLocalize.GetLocalizedStringValue("back")</a>
                                            </div>

                                        </div>

                                    </div>
                                </EditForm>
                            </div>
                        </div>

                    </div>
                    <!-- /.box-body -->
                </div>
                <!-- /.box -->
            </div>
            <!-- /.col -->
        </div>
    </div>
</section>
@code {
    public CreateTaxClassDto create { get; set; }
    private List<LanguageDto> languges;
    public string lang { get; set; }
    protected override async Task OnInitializedAsync()
    {
        create = new CreateTaxClassDto();
        http.DefaultRequestHeaders.Add("Accept", "application/json");
        lang = await http.GetFromJsonAsync<string>("api/Language/GetDefaultLanugage");
        languges = await _homeBL.GetLanguages(lang);
    }
    string message = "";
    string style = "";
    async Task AddTaxClass()
    {
            var result = await _locationTaxBL.AddTaxClass(1, create);
            if (result.Success)
            {
                message = result.Message;
                style = "success";
            }
            else
            {
                message = result.Message;
                style = "danger";
            }
        
    }
}
