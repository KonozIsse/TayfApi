@page "/CP/Taxes/Edit"
@page "/CP/Taxes/Edit/{Id:int}"
@inject LocationTaxBL _locationTaxBL;
@inject HomeBL _homeBL;
@inject LocService SharedLocalize

<PageTitle>@SharedLocalize.GetLocalizedStringValue("edittaxes") | @SharedLocalize.GetLocalizedStringValue("ControlPanel")</PageTitle>
<Alert Message="@message" Style="@style"></Alert>

<section class="content-header">
    <h1>@SharedLocalize.GetLocalizedStringValue("taxclass")<small>@SharedLocalize.GetLocalizedStringValue("edittaxes")</small> </h1>
    <ol class="breadcrumb">
        <li class="fa fa-dashboard">@SharedLocalize.GetLocalizedStringValue("dashboard")</li>
        <li class="fa fa-users">@SharedLocalize.GetLocalizedStringValue("taxclass")</li>
        <li class="active">@SharedLocalize.GetLocalizedStringValue("edittaxes")</li>
    </ol>
</section>

<!-- Main content -->
<section class="content">
    <div class="row">
        <div class="col-md-12">
            <div class="box">
                <div class="box-header">
                    <h3 class="box-title">@SharedLocalize.GetLocalizedStringValue("edittaxes")</h3>
                </div>
                <div class="box-body">
                    <div class="row">
                        <div class="col-xs-12">
                            <div class="box box-info">
                                <br>
                                <EditForm Model="@create" OnValidSubmit="@EditTaxClass">
                                        <DataAnnotationsValidator />
                                    <div class="form-horizontal">
                                        <div class="box-body">
                                            <div class="form-group">
                                                <label class="col-sm-2 col-md-3 control-label">
                                                    @SharedLocalize.GetLocalizedStringValue("title")<span style="color:red;">*</span>

                                                </label>
                                                <div class="col-sm-10 col-md-4">
                                                    <InputText class="form-control" @bind-Value="create.Title" />
                                                    <ValidationMessage For="@(() => create.Title)" />
                                                </div>
                                            </div>
                                            <div class="form-group">
                                                <label class="col-sm-2 col-md-3 control-label">
                                                    @SharedLocalize.GetLocalizedStringValue("desc")
                                                </label>
                                                <div class="col-sm-10 col-md-4">
                                                    <InputText class="form-control" @bind-Value="create.Description" />
                                                    <ValidationMessage For="@(() => create.Description)" />
                                                </div>
                                            </div>
                                            <div class="box-footer text-center">
                                                <button type="submit" class="btn btn-primary">@SharedLocalize.GetLocalizedStringValue("Submit")</button>
                                                <a href="/CP/Taxes" type="submit" class="btn btn-defult">@SharedLocalize.GetLocalizedStringValue("back")</a>
                                            </div>

                                        </div>

                                    </div>
                                </EditForm>
                            </div>
                        </div>

                    </div>
                    <!-- /.box-body -->
                </div>
                <!-- /.box -->
            </div>
            <!-- /.col -->
        </div>
    </div>
</section>
@code {
    [Parameter]
    public int Id { get; set; }
    UpdateTaxClassDto create = new UpdateTaxClassDto();
    string message;
    string style;
    string lang = "en";
    int storeId = 3;
    protected override async Task OnInitializedAsync()
    {
        create = new UpdateTaxClassDto();
        create = await _locationTaxBL.GetTaxClassId(Id);
    }

    async Task EditTaxClass()
    {
        create.Id = Id;
        var result = await _locationTaxBL.EditTaxClass(storeId, create);
        if (result.Success)
        {
            message = result.Message;
            style = "success";
        }
        else
        {
            message = result.Message;
            style = "danger";
        }
    }

}
