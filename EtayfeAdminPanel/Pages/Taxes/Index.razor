@page "/Taxes"
<PageTitle>@SharedLocalize.GetLocalizedStringValue("taxclass") | @SharedLocalize.GetLocalizedStringValue("ControlPanel")</PageTitle>
<Alert Message="@message"  Style="@style"></Alert>

<section class="content-header">
    <h1>  @SharedLocalize.GetLocalizedStringValue("taxclass") <small> @SharedLocalize.GetLocalizedStringValue("taxclass")</small> </h1>
    <ol class="breadcrumb">
        <li class="fa fa-dashboard">@SharedLocalize.GetLocalizedStringValue("dashboard") </li>
        <li class="active"> @SharedLocalize.GetLocalizedStringValue("taxclass") </li>
    </ol>
</section>

<section class="content">
    @if(Model != null)
    {
        <div class="row">
            <div class="col-md-12">
                <div class="box">
                    <div class="box-header">
                        <div class="box-header">
                            <div class="col-lg-6 form-inline" id="contact-form">
                                <form class="registration" method="get">
                                    <div class="input-group-form search-panel ">
                                        <select type="button" class="btn btn-default dropdown-toggle form-control" data-toggle="dropdown" @bind="@filter">
                                            <option value="-1" selected="" disabled="" hidden="">@SharedLocalize.GetLocalizedStringValue("FilterBy")</option>
                                            <option value="0">@SharedLocalize.GetLocalizedStringValue("Name")</option>
                                            <option value="1">@SharedLocalize.GetLocalizedStringValue("details")</option>
                                        </select>
                                        <input type="text" class="form-control input-group-form" placeholder="@SharedLocalize.GetLocalizedStringValue("search")" @bind-value="@search" />
                                        <button type="button" class="btn btn-primary" @onclick="@GetSliderWeb"><i class="oi oi-magnifying-glass"></i></button>
                                        <a onClick="window.location.reload()" type="button" style="display:inline-block; width: auto; margin-top: 0;" class="btn btn-default"><i class="fa fa-refresh"></i></a>

                                    </div>
                                </form>
                                <div class="col-lg-4 form-inline" id="contact-form12"></div>
                            </div>
                            <div class="box-tools pull-right">
                                <a href="/Tax/Add" type="button" style="display:inline-block; width: auto; margin-top: 0;" class="btn btn-block btn-primary">@SharedLocalize.GetLocalizedStringValue("addtaxes")</a>
                            </div>
                        </div>

                    </div>

                    <!-- /.box-header -->
                    <div class="box-body">
                        <div class="row">
                            <div class="col-xs-12">
                            </div>
                        </div>


                        <div class="row">
                            <div class="col-xs-12 table-responsive">
                                @if (Model.Count() > 0)
                                {
                                    <table id="example1" class="table table-bordered table-striped">
                                        <thead>
                                            <tr>
                                                <th> #</th>
                                                <th>@SharedLocalize.GetLocalizedStringValue("Name")</th>
                                                <th>@SharedLocalize.GetLocalizedStringValue("details")</th>
                                                <th>@SharedLocalize.GetLocalizedStringValue("AddedDate")/@SharedLocalize.GetLocalizedStringValue("updateDate")</th>
                                                <th>@SharedLocalize.GetLocalizedStringValue("Actions")</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @{
                                                var i = 0;
                                            }
                                            @foreach (var item in Model)
                                            {

                                                i += 1;

                                                <tr>
                                                    <td>@i</td>
                                                    <td>@item.Title</td>
                                                    <td>@item.Description</td>
                                                    <td>
                                                        @SharedLocalize.GetLocalizedStringValue("AddedDate") : @item.CreateAt <br />
                                                        @SharedLocalize.GetLocalizedStringValue("updateDate") : @item.CreateAt

                                                    </td>
                                                    <td>
                                                        <a data-toggle="tooltip" data-placement="bottom" title=" @SharedLocalize.GetLocalizedStringValue("edit")" href="/Tax/Edit/@item.Id" class="badge bg-light-blue"><i class="fa fa-pencil-square-o" aria-hidden="true"></i></a>
                                                        <a title="delete" @onclick="(async ()=> await Delete(item.Id))" class="badge bg-red"> <i class="fa fa-trash" aria-hidden="true"></i></a>

                                                    </td>

                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                }
                                else
                                {
                                    <div class="col-xs-12 @(lang == "ar"?"text-right":"text-left")">
                                        @SharedLocalize.GetLocalizedStringValue("NoRecordfound").
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                    <!-- /.box-body -->
                </div>
                <!-- /.box -->
            </div>
            <!-- /.col -->
        </div>

        @if (Model.Count >= 10)
        {
            <Pagination MetaData="MetaData" Spread="2" SelectedPage="SelectedPage" />
        }
    }
</section>

@code {
    [Parameter]
    public string search { get; set; }
    [Parameter]
    public string filter { get; set; }
    [Parameter]
    public string lang { get; set; }
    public List<TaxClassDto> Model { get; set; }

    public MetaData MetaData { get; set; } = new MetaData();
    private PostsParameters _PostsParameters = new PostsParameters();

    protected override async Task OnInitializedAsync()
    {
        http.DefaultRequestHeaders.Add("Accept", "application/json");
        lang = await http.GetFromJsonAsync<string>("api/Language/GetDefaultLanugage");
        await GetSliderWeb();
    }
    private async Task SelectedPage(int page)
    {
        _PostsParameters.PageNumber = page;
        await GetSliderWeb();
    }
    async Task GetSliderWeb()
    {
        var pagingResponse = await _locationTaxBL.GetTaxes(search, filter, lang, _PostsParameters);
        Model = pagingResponse.ToList();
        MetaData = pagingResponse.MetaData;
    }
    string message = "";
    string style = "";
    async Task Delete(int id)
    {
        var confirm = await js.InvokeAsync<bool>("confirm", "Are you sure ");
        if (confirm)
        {
            var result = await _locationTaxBL.DeleteTaxClass(id);
            if (result.Success)
            {
                message = result.Message;
                style = "success";
            }
            else
            {
                message = result.Message;
                style = "danger";
            }
            NavigationManager.NavigateTo("/Taxes", true);
        }
    }
}