
@page "/Language/Edit/{id:int}"

<PageTitle>@SharedLocalize.GetLocalizedStringValue("EditLang") | @SharedLocalize.GetLocalizedStringValue("ControlPanel")</PageTitle>
<Alert Message="@message" Style="@style"></Alert>

<section class="content-header">
    <h1>@SharedLocalize.GetLocalizedStringValue("lang")<small>@SharedLocalize.GetLocalizedStringValue("EditLang")</small> </h1>
    <ol class="breadcrumb">
        <li class="fa fa-dashboard"> @SharedLocalize.GetLocalizedStringValue("dashboard")</li>
        <li class="fa fa-users">@SharedLocalize.GetLocalizedStringValue("Lang")</li>
        <li class="active">@SharedLocalize.GetLocalizedStringValue("EditLang")</li>
    </ol>
</section>
<section class="content">

    <div class="row">
        <div class="col-md-12">
            <div class="box">
                <div class="box-header">
                    <h3 class="box-title">@SharedLocalize.GetLocalizedStringValue("EditLang")</h3>
                </div>

                <!-- /.box-header -->
                <div class="box-body">
                    <div class="row">
                        <div class="col-xs-12">
                            <div class="box box-info">
                                <br>


                                 <EditForm Model="@create" OnValidSubmit="@UpdateLanguage">
                                    <DataAnnotationsValidator />
                                    <div class="form-horizontal">
                                        <div class="box-body">
                                            <div class="form-group">
                                                <label class="col-sm-2 col-md-3 control-label">@SharedLocalize.GetLocalizedStringValue("Language") (@create.Code)</label>
                                                <div class="col-sm-10 col-md-4">
                                                    <InputText name="Name" required="required" class="form-control" @bind-Value="create.Name" />  
                                                    <ValidationMessage For="@(() => create.Name)" />
                                                </div>
                                            </div>
                                            <div class="form-group">
                                                <label class="col-sm-2 col-md-3 control-label">@SharedLocalize.GetLocalizedStringValue("Language") (@create.Code)</label>
                                                <div class="col-sm-10 col-md-4">
                                                    <InputText name="Name" required="required" class="form-control" @bind-Value="create.NameAr" />
                                                    <ValidationMessage For="@(() => create.NameAr)" />
                                                </div>
                                            </div>
                                            <div class="form-group">
                                                <label class="col-sm-2 col-md-3 control-label">@SharedLocalize.GetLocalizedStringValue("Code")<span style="color:red;">*</span></label>
                                                <div class="col-sm-10 col-md-4">
                                                    <div class="col-sm-10 col-md-4">
                                                        <InputText class="form-control field-validate text-box single-line" @bind-Value="create.Code" disabled="disabled" />
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="form-group">
                                                <label class="col-sm-2 col-md-3 control-label">@SharedLocalize.GetLocalizedStringValue("direction")<span style="color:red;">*</span></label>
                                                <div class="col-sm-10 col-md-4">
                                                    <InputSelect class="form-control field-validate" name="direction" @bind-Value="create.Direction">
                                                        <option value="rtl">@SharedLocalize.GetLocalizedStringValue("RightToLeft")</option>
                                                        <option value="ltr">@SharedLocalize.GetLocalizedStringValue("LeftToRight")</option>
                                                    </InputSelect>
                                                    <ValidationMessage For="@(() => create.Direction)" />
                                                </div>
                                            </div>
                                            <style>
                                                img {
                                                    height: 100% !important;
                                                    border: none !important;
                                                }
                                            </style>
                                            <div class="form-group" id="imageIcone2">
                                                <label class="col-sm-2 col-md-3 control-label">@SharedLocalize.GetLocalizedStringValue("icon")<span style="color:red;">*</span></label>
                                                <div class="col-sm-10 col-md-4">
                                                    <!-- Modal -->
                                                    <div class="modal fade embed-images" id="ModalmanufacturedICone2" tabindex="-1" role="dialog" aria-labelledby="myModalLabel">
                                                        <div class="modal-dialog" role="document">
                                                            <div class="modal-content">
                                                                <div class="modal-header">
                                                                    <button type="button" class="close" data-dismiss="modal" id="closemodal" aria-label="Close"><span aria-hidden="true">×</span></button>
                                                                    <h3 class="modal-title text-primary" id="myModalLabel2">@SharedLocalize.GetLocalizedStringValue("addImg")</h3>
                                                                </div>
                                                                <div class="modal-body manufacturer-image-embed">
                                                                    @if (images != null)
                                                                    {
                                                                        <ul class="thumbnails image_picker_selector">

                                                                            @foreach (var i in images)
                                                                            {
                                                                                <li>
                                                                                    <span class="emailTable">
                                                                                        <label title="Spreadsheet for accounting">
                                                                                            <div class="thumbnail">

                                                                                                <img class="image_picker_image" src="@i.Path" alt="@i.ImgId">
                                                                                                <input class="imgSrcc" value="@i.Path" hidden>
                                                                                                <input id="@i.Path" type="checkbox" class="lstt" name="im" value="@i.ImgId" onchange="onSelectImg()" />

                                                                                            </div>
                                                                                        </label>
                                                                                    </span>
                                                                                </li>
                                                                            }
                                                                        </ul>
                                                                    }
                                                                </div>
                                                                <div class="modal-footer">

                                                                    <a href="/Media" target="_blank" class="btn btn-primary pull-left">@SharedLocalize.GetLocalizedStringValue("addImg")</a>
                                                                    <a class="btn btn-default refresh-image shownotify newIcon" id="reff"><i class="fa fa-refresh"></i></a>
                                                                    <button type="button" class="btn btn-success" id="selectedICONE" data-dismiss="modal">@SharedLocalize.GetLocalizedStringValue("add")</button>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div id="imageselected2">
                                                        <input value="Others" hidden id="typeImg" />
                                                        <a id="newIcon2" data-id="1" class="newIcon btn btn-primary field-validate" data-toggle="modal" data-target="#ModalmanufacturedICone2" type="button">@SharedLocalize.GetLocalizedStringValue("addImg")</a>
                                                        <br>
                                                        <div id="selectedthumbnailIcon2" class="selectedthumbnail col-md-5"> </div>
                                                        <div class="closimage">
                                                            <button type="button" class="close pull-left image-close " id="image-Icone" style="display: none; position: absolute;left: 105px; top: 54px; background-color: black; color: white; opacity: 2.2; " aria-label="Close">
                                                                <span aria-hidden="true">×</span>
                                                            </button>
                                                        </div>
                                                    </div>
                                                    <br />
                                                    <br />

                                                    <img id="imgCont" width="80px" src="">
                                                    <span class="help-block" style="font-weight: normal;font-size: 11px;margin-bottom: 0;">@SharedLocalize.GetLocalizedStringValue("UploadYourImages")</span>

                                                    <br>
                                                </div>
                                            </div>

                                            <div class="box-footer text-center">
                                                <button type="submit" class="btn btn-primary">@SharedLocalize.GetLocalizedStringValue("Submit")</button>
                                                <a href="/Languages" type="submit" class="btn btn-default"> @SharedLocalize.GetLocalizedStringValue("back")</a>
                                            </div>


                                        </div>

                                    </div>
                                    </EditForm>
                                
                            </div>
                        </div>

                    </div>
                    <!-- /.box-body -->
                </div>
                <!-- /.box -->
            </div>
            <!-- /.col -->
        </div>
    </div>
</section>

@code {
    [Parameter]
    public int id { get; set; }
    public List<ImageSettingDto> images { get; set; }
    public AdminDto user { get; set; }
    UpdateLanguageDto create = new UpdateLanguageDto();
    string message;
    string style;
    string image;
    protected override async Task OnInitializedAsync()
    {
        create = new UpdateLanguageDto();
        if(id != 0)
        {
            create = await _homeBL.GetLanugage(id);
        }
        http.DefaultRequestHeaders.Add("Accept", "application/json");
        user = await http.GetFromJsonAsync<AdminDto>("api/Account/currentUser");
        images = await _imageBL.GetAllImageSettingOriginal(user.Id);
       // image = $"/media_files/medium/{image.Name}";
    }

    async Task UpdateLanguage()
    {
        var result = await _homeBL.UpdateLanguage(id,create);
        if (result.Success)
        {
            message = result.Message;
            style = "success";
        }
        else
        {
            message = result.Message;
            style = "danger";
        }
    }
    
    
}