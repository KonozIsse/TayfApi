
@page "/Language/Edit/{id:int}"

<PageTitle>@SharedLocalize.GetLocalizedStringValue("EditLang") | @SharedLocalize.GetLocalizedStringValue("ControlPanel")</PageTitle>
<Alert Message="@message" Style="@style"></Alert>

<section class="content-header">
    <h1>@SharedLocalize.GetLocalizedStringValue("lang")<small>@SharedLocalize.GetLocalizedStringValue("EditLang")</small> </h1>
    <ol class="breadcrumb">
        <li class="fa fa-dashboard"> @SharedLocalize.GetLocalizedStringValue("dashboard")</li>
        <li class="fa fa-users">@SharedLocalize.GetLocalizedStringValue("Lang")</li>
        <li class="active">@SharedLocalize.GetLocalizedStringValue("EditLang")</li>
    </ol>
</section>
<section class="content">

    <div class="row">
        <div class="col-md-12">
            <div class="box">
                <div class="box-header">
                    <h3 class="box-title">@SharedLocalize.GetLocalizedStringValue("EditLang")</h3>
                </div>

                <!-- /.box-header -->
                <div class="box-body">
                    <div class="row">
                        <div class="col-xs-12">
                            <div class="box box-info">
                                <br>


                                 <EditForm Model="@create" OnValidSubmit="@UpdateLanguage">
                                    <DataAnnotationsValidator />
                                    <div class="form-horizontal">
                                        <div class="box-body">
                                            <div class="form-group">
                                                <label class="col-sm-2 col-md-3 control-label">@SharedLocalize.GetLocalizedStringValue("Language") (@create.Code)</label>
                                                <div class="col-sm-10 col-md-4">
                                                    <InputText name="Name" required="required" class="form-control" @bind-Value="create.Name" />  
                                                    <ValidationMessage For="@(() => create.Name)" />
                                                </div>
                                            </div>
                                            <div class="form-group">
                                                <label class="col-sm-2 col-md-3 control-label">@SharedLocalize.GetLocalizedStringValue("Language") (@create.Code)</label>
                                                <div class="col-sm-10 col-md-4">
                                                    <InputText name="Name" required="required" class="form-control" @bind-Value="create.NameAr" />
                                                    <ValidationMessage For="@(() => create.NameAr)" />
                                                </div>
                                            </div>
                                            <div class="form-group">
                                                <label class="col-sm-2 col-md-3 control-label">@SharedLocalize.GetLocalizedStringValue("Code")<span style="color:red;">*</span></label>
                                                <div class="col-sm-10 col-md-4">
                                                    <div class="col-sm-10 col-md-4">
                                                        <InputText class="form-control field-validate text-box single-line" @bind-Value="create.Code" disabled="disabled" />
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="form-group">
                                                <label class="col-sm-2 col-md-3 control-label">@SharedLocalize.GetLocalizedStringValue("direction")<span style="color:red;">*</span></label>
                                                <div class="col-sm-10 col-md-4">
                                                    <InputSelect class="form-control field-validate" name="direction" @bind-Value="create.Direction">
                                                        <option value="rtl">@SharedLocalize.GetLocalizedStringValue("RightToLeft")</option>
                                                        <option value="ltr">@SharedLocalize.GetLocalizedStringValue("LeftToRight")</option>
                                                    </InputSelect>
                                                    <ValidationMessage For="@(() => create.Direction)" />
                                                </div>
                                            </div>
                                           

                                            <div class="box-footer text-center">
                                                <button type="submit" class="btn btn-primary">@SharedLocalize.GetLocalizedStringValue("Submit")</button>
                                                <a href="/Languages" type="submit" class="btn btn-default"> @SharedLocalize.GetLocalizedStringValue("back")</a>
                                            </div>


                                        </div>

                                    </div>
                                    </EditForm>
                                
                            </div>
                        </div>

                    </div>
                    <!-- /.box-body -->
                </div>
                <!-- /.box -->
            </div>
            <!-- /.col -->
        </div>
    </div>
</section>

@code {
    [Parameter]
    public int id { get; set; }
    private List<ImageDto> images;
    UpdateLanguageDto create = new UpdateLanguageDto();
    string message;
    string style;
    string image;
    protected override async Task OnInitializedAsync()
    {
        create = new UpdateLanguageDto();
        if(id != 0)
        {
            create = await _homeBL.GetLanugage(id);
        }
        images = await _imageBL.GetAllImages();
       // image = $"/media_files/medium/{image.Name}";
    }

    async Task UpdateLanguage()
    {
        create.ImgId = 3;
        var result = await _homeBL.UpdateLanguage(id,create);
        if (result.Success)
        {
            message = result.Message;
            style = "success";
        }
        else
        {
            message = result.Message;
            style = "danger";
        }
    }
    
    
}