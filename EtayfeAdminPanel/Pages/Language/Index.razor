@page "/Languages"
<PageTitle>@SharedLocalize.GetLocalizedStringValue("lang")| @SharedLocalize.GetLocalizedStringValue("ControlPanel")</PageTitle>

<section class="content-header">
    <h1>  @SharedLocalize.GetLocalizedStringValue("lang") <small>Listing All The @SharedLocalize.GetLocalizedStringValue("lang").</small> </h1>
    <ol class="breadcrumb">
        <li><a href="/index">@SharedLocalize.GetLocalizedStringValue("dashboard")</a></li>
        <li class="active"> @SharedLocalize.GetLocalizedStringValue("lang")</li>
    </ol>
</section>

@if (Model != null)
{
    <section class="content">
        <!-- Info boxes -->
        <!-- /.row -->
        <div class="row">
            <div class="col-md-12">
                <div class="box">
                    <div class="box-header">
                        <div class="col-lg-6 form-inline" id="contact-form">
                            <form class="registration" method="get">
                                <div class="input-group-form search-panel ">
                                    <select type="button" class="btn btn-default dropdown-toggle form-control" data-toggle="dropdown" @bind="@filter">
                                        <option value="-1" selected="" disabled="" hidden="">@SharedLocalize.GetLocalizedStringValue("FilterBy")</option>
                                        <option value="0">@SharedLocalize.GetLocalizedStringValue("lang")</option>
                                        <option value="1">@SharedLocalize.GetLocalizedStringValue("Code")</option>
                                    </select>
                                    <input type="text" class="form-control input-group-form" placeholder="@SharedLocalize.GetLocalizedStringValue("search")" @bind-value="@search" />
                                    <button type="button" class="btn btn-primary" @onclick="@GetLanguages"><i class="oi oi-magnifying-glass"></i></button>
                                    <a @onclick="(()=> NevigateToYourUrl())" type="button" style="display:inline-block; width: auto; margin-top: 0;" class="btn btn-default"><i class="fa fa-refresh"></i></a>
                                   
                                </div>
                            </form>
                            <div class="col-lg-4 form-inline" id="contact-form12"></div>
                        </div>

                    </div>

                    <!-- /.box-header -->
                    <div class="box-body">
                        <div class="row">
                            <div class="col-xs-12">
                            </div>
                        </div>
                        <div class="row">
                            
                            <div class="col-xs-12 table-responsive">
                                @if (Model.Count() > 0)
                                {
                                    <table id="example1" class="table table-bordered table-striped">
                                        <thead>
                                            <tr>
                                                <th># </th>
                                                <th><a href="#">@SharedLocalize.GetLocalizedStringValue("DefaultLanguage")</a></th>
                                                <th><a href="#">@SharedLocalize.GetLocalizedStringValue("lang")</a> </th>
                                                <th>@SharedLocalize.GetLocalizedStringValue("icon")</th>
                                                <th><a href="#">@SharedLocalize.GetLocalizedStringValue("Code")</a> </th>
                                                <th><a href="#">@SharedLocalize.GetLocalizedStringValue("sort")</a></th>
                                                <th>@SharedLocalize.GetLocalizedStringValue("Actions")</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @{
                                                var i = 0;
                                            }
                                            @foreach (var item in Model)
                                            {
                                                i += 1;
                                                <tr>
                                                    <td>@i</td>
                                                    <td>
                                                        <label>
                                                            <input @onclick="(async()=> await DefaultLang(item.Id))" type="radio" name="default" class="default_language" checked=@item.IsDefault />
                                                        </label>
                                                    </td>
                                                    <td>@item.Name</td>
                                                    <td><img src="@item.Image" width="25px" alt=""/></td>
                                                    <td>@item.Code</td>
                                                    <td>@item.Sort</td>
                                                    <td>
                                                        <a data-toggle="tooltip" data-placement="bottom" title=" @item.Name" href="/Language/Edit/@item.Id" class="badge bg-light-blue"><i class="fa fa-pencil-square-o" aria-hidden="true"></i></a>

                                                    </td>

                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                }
                                else
                                {
                                    <div class="col-xs-12 @(lang == "ar"?"text-right":"text-left")">
                                        @SharedLocalize.GetLocalizedStringValue("NoRecordfound").
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                    <!-- /.box-body -->
                </div>
                <!-- /.box -->
            </div>
            <!-- /.col -->
        </div>

        @if (Model.Count() >= 10)
        {
            <Pagination MetaData="MetaData" Spread="2" SelectedPage="SelectedPage" />
        }
    </section>
}
@code {
    [Parameter]
    public string search { get; set; }
    public string filter { get; set; }
    public string lang { get; set; }
    public List<LanguageDto> Model { get; set; }
    public MetaData MetaData { get; set; } = new MetaData();
    private PostsParameters _PostsParameters = new PostsParameters();

    protected override async Task OnInitializedAsync()
    {
        http.DefaultRequestHeaders.Add("Accept", "application/json");
        lang = await http.GetFromJsonAsync<string>("api/Language/GetDefaultLanugage");
        await GetLanguages();
    }
    private async Task SelectedPage(int page)
    {
        _PostsParameters.PageNumber = page;
        await GetLanguages();
    }
    async Task GetLanguages()
    {
        var pagingResponse = await _homeBL.GetAllLanguages(search, filter, lang, _PostsParameters);
        Model = pagingResponse.ToList();
        MetaData = pagingResponse.MetaData;
    }
    async Task DefaultLang(int id)
    {
        await _homeBL.ChangeDefaultLanugage(id);
        NavigationManager.NavigateTo("/Languages", true);
    }
  
    void NevigateToYourUrl()
    {
        NavigationManager.NavigateTo("/Languages", true);
    }
  
   
}
