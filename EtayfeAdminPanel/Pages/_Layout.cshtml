    @*Images*@

    <script type="text/javascript">
      
        jQuery(document).on("click", ".ConfirmDelete", function () {
            var checkedIds = [];
            var weights = [];

            $('div > .thumbnail').each(function () {
                if ($(this).find('input[type="checkbox"]').is(":checked")) {
                    checkedIds.push($(this).find('input[type="checkbox"]').attr('id'));
                }
            });

            if (checkedIds == null || checkedIds == 0 || checkedIds == "") {
                alert("Please choose image");
                return;
            }
            jQuery("#Confirm").modal("show");
            var xhttp = new XMLHttpRequest();
            xhttp.open("DELETE", "https://localhost:44360/api/Media/deleteListImages/" + checkedIds, true);
            xhttp.send();
            xhttp.onreadystatechange = function () {

                if (this.readyState == 4 && this.status == 200) {
                    alert(this.response);
                    location.reload();
                }else{
                    alert(this.response);
                    location.reload();
                }
            };
            console.log("url " + UrlPrefix + checkedIds);

            return false;
        });
        function check(){

            var get= document.getElementsByName('check');

            for(var i= 0; i<get.length; i++){

            get[i].checked= true;}

        }
        function unCheck() {

            var get = document.getElementsByName('check');

            for (var i = 0; i < get.length; i++) {

                get[i].checked = false;
            }

        }
        function checkAll() {
            if (document.getElementById('ckb').checked) {
                $('.ckb:checkbox').each(function () {
                    this.checked = true;
                });
            } else {
                $('.ckb:checkbox').each(function () {
                    this.checked = false;
                });
            }
        }

      

    </script>
    <script type="text/javascript">
        function flash(a) {
            if (a.value == 1) {
                jQuery("#loader").css("display", "block");

                jQuery(".flash-container").css("display", "block");

                setTimeout(function () {
                    jQuery("#loader").css("display", "none");
                }, 300);

            } else {
                jQuery(".flash-container").css("display", "none");

            }
        }

        function DefProduct(a) {
            if (a.value == 1) {
                jQuery("#loader").css("display", "block");
                jQuery(".defPrice").css("display", "none");

                setTimeout(function () {
                    jQuery("#loader").css("display", "none");
                }, 300);
            } else {
                jQuery(".defPrice").css("display", "block");

            }
        }

        function showList(a) {
            if (a.value == "fixed_product" || a.value == "percent_product") {

                jQuery("#loader").css("display", "block");
                jQuery(".flst").css("display", "block");

                setTimeout(function () {
                    jQuery("#loader").css("display", "none");
                }, 300);
            } else {
                jQuery(".flst").css("display", "none");

            }
        }

        function special(a) {
            //console.log(a.value);
            if (a.value == 1) {
                jQuery("#loader").css("display", "block");

                jQuery(".special-container").css("display", "block");

                setTimeout(function () {
                    jQuery("#loader").css("display", "none");
                }, 300);
            } else {
                jQuery(".special-container").css("display", "none");

            }
        }

    </script>

   
