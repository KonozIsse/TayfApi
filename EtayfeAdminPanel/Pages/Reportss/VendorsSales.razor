@page "/Reports/VendorsSales"

<PageTitle>@SharedLocalize.GetLocalizedStringValue("VendorsSalesReport") | @SharedLocalize.GetLocalizedStringValue("ControlPanel")</PageTitle>

<section class="content-header">
    <h1>@SharedLocalize.GetLocalizedStringValue("VendorsSalesReport") <small> @SharedLocalize.GetLocalizedStringValue("VendorsSalesReport")</small> </h1>
    <ol class="breadcrumb">
        <li class="fa fa-dashboard">@SharedLocalize.GetLocalizedStringValue("dashboard")</li>
        <li class="active">@SharedLocalize.GetLocalizedStringValue("VendorsSalesReport") </li>
    </ol>
</section>
@if (Model != null)
{
    <section class="content">
        <!-- Info boxes -->
        <!-- /.row -->

        <div class="row">
            <div class="col-md-12">
                <div class="box">
                    <div class="box-header">
                        <h3 class="box-title">@SharedLocalize.GetLocalizedStringValue("VendorsSalesReport") </h3>
                    </div>
                    <div class="box-header">
                        <div class="container-fluid">
                            <div class="row">
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-6 form-inline" id="contact-form">
                        <form class="registration" method="get">
                            <div class="input-group-form search-panel ">

                               
                                <input type="text" class="form-control input-group-form" placeholder="@SharedLocalize.GetLocalizedStringValue("search")" @bind-value="@search" />
                                <button type="button" class="btn btn-primary" @onclick="@GetCustomerTotal"><i class="oi oi-magnifying-glass"></i></button>
                            <a onClick="window.location.reload()" type="button" style="display:inline-block; width: auto; margin-top: 0;" class="btn btn-default"><i class="fa fa-refresh"></i></a>

                            </div>
                        </form>

                    </div>
                    @*onclick="exportTableToExcel1('html_table', 'Vendor Sales Report')"*@
                    <div class="col-lg-6 form-inline" id="contact-form12">
                        <button @onclick="ExportAsCSV" class="btn btn-success  @(lang=="en"?"pull-right":"pull-left")" style="@(lang =="en" ? "margin-right: 2%;" : "margin-left: 2%;")"><i class="fa fa-file-excel"></i> @SharedLocalize.GetLocalizedStringValue("excel")</button>
                        <button onclick="printJS('html_table', 'html')" class="btn btn-primary @(lang=="en"?"pull-right":"pull-left")" style="@(lang =="en" ? "margin-right: 2%;" : "margin-left: 2%;")"><i class="fa fa-print"></i> @SharedLocalize.GetLocalizedStringValue("Print")</button>
                    </div>


                    <!-- /.box-header -->
                    <div class="box-body">
                        <div class="row">
                            <div class="col-xs-12">
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-xs-12">
                                @if (Model.Count() > 0)
                                {
                                    <table id="html_table" class="table table-bordered table-striped">
                                        <thead>
                                            <tr>
                                                <th>#</th>
                                                <th>@SharedLocalize.GetLocalizedStringValue("vendor") </th>
                                                <th>@SharedLocalize.GetLocalizedStringValue("Email")</th>
                                                <th>@SharedLocalize.GetLocalizedStringValue("Mobile")</th>
                                                <th>@SharedLocalize.GetLocalizedStringValue("TotalPurchased")</th>
                                            </tr>
                                        </thead>
                                        <tbody>

                                            @{
                                                var i = 0;
                                            }
                                            @foreach (var item in Model)
                                            {

                                                i += 1;
                                                <tr>
                                                    <td>@i</td>
                                                    <td>@item.FirstName</td>
                                                    <td>@item.Email</td>
                                                    <td>@item.PhoneNumber</td>
                                                    <td>
                                                        <a href="/Order/View/@item.Id" target="_blank">QAR @item.TotalPrice</a>

                                                    </td>
                                                </tr>
                                            }

                                        </tbody>
                                    </table>
                                }
                                else
                                {
                                    <div class="col-xs-12 @(lang == "ar"?"text-right":"text-left")">
                                        @SharedLocalize.GetLocalizedStringValue("NoRecordfound").
                                    </div>
                                }

                            </div>
                        </div>
                    </div>
                    <!-- /.box-body -->
                </div>
                <!-- /.box -->
            </div>
            <!-- /.col -->
        </div>
     @if (Model.Count >= 10)
    {
        <Pagination MetaData="MetaData" Spread="2" SelectedPage="SelectedPage" />
    }
    </section>
}
@code {
    [Parameter]
    public string search { get; set; }
    public string lang { get; set; }
    public List<StoreDto> Model { get; set; }
    public MetaData MetaData { get; set; } = new MetaData();
    private PostsParameters _PostsParameters = new PostsParameters();

    protected override async Task OnInitializedAsync()
    {
        http.DefaultRequestHeaders.Add("Accept", "application/json");
        lang = await http.GetFromJsonAsync<string>("api/Language/GetDefaultLanugage");
        await GetCustomerTotal();
    }
    private async Task SelectedPage(int page)
    {
        _PostsParameters.PageNumber = page;
        await GetCustomerTotal();
    }
    async Task GetCustomerTotal()
    {
        var pagingResponse = await _userBL.GetVendorTotal(search, _PostsParameters);
        Model = pagingResponse.ToList();
        MetaData = pagingResponse.MetaData;
    }
    private async Task ExportAsCSV()
    {
        using (var memoryStream = new MemoryStream())
        {
            using (var writer = new StreamWriter(memoryStream))
            {
                //using (var csv = new CsvHelper.CsvWriter(writer,SharedLocalize.GetLocalizedString("")))
                //{
                //    csv.WriteRecords(Model);
                //}

                var arr = memoryStream.ToArray();
                await js.SaveAs("people.csv", arr);
            }
        }
    }
}
