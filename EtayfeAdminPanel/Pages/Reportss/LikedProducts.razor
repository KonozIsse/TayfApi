@page "/CP/Reports/LikedProducts"
@inject ProductBL _productBL
@inject HomeBL _homeBL
@inject LocService SharedLocalize
@inject UserManager<User> _userManager
@attribute [Authorize]

<PageTitle>@SharedLocalize.GetLocalizedStringValue("LikedProducts") | @SharedLocalize.GetLocalizedStringValue("ControlPanel")</PageTitle>

<section class="content-header">
    <h1>@SharedLocalize.GetLocalizedStringValue("LikedProducts") <small> @SharedLocalize.GetLocalizedStringValue("OutofStock")</small> </h1>
    <ol class="breadcrumb">
        <li class="fa fa-dashboard">@SharedLocalize.GetLocalizedStringValue("dashboard")</li>
        <li class="active">@SharedLocalize.GetLocalizedStringValue("LikedProducts") </li>
    </ol>
</section>

@if(Model != null)
{
    <section class="content">
        <!-- Info boxes -->
        <!-- /.row -->

        <div class="row">
            <div class="col-md-12">
                <div class="box">
                    <div class="box-header">
                        <h3 class="box-title">@SharedLocalize.GetLocalizedStringValue("products") </h3>
                    </div>
                    <div class="box-header">
                        <div class="container-fluid">
                            <div class="row">
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-6 form-inline" id="contact-form">
                        <form class="registration" method="get">
                            <div class="input-group-form search-panel ">

                                <input type="text" class="form-control input-group-form" placeholder="@SharedLocalize.GetLocalizedStringValue("search")" @bind-value="@search" />
                                <button type="button" class="btn btn-primary" @onclick="@GetLikedProducts"><i class="oi oi-magnifying-glass"></i></button>

                                <a onClick="window.location.reload()" type="button" style="display:inline-block; width: auto; margin-top: 0;" class="btn btn-default"><i class="fa fa-refresh"></i></a>

                            </div>
                        </form>
                        <div class="col-lg-4 form-inline" id="contact-form12"></div>
                    </div>
                    <!-- /.box-header -->
                    <div class="box-body">
                        <div class="row">
                            <div class="col-xs-12">
                            </div>
                        </div>
                        <div class="row tableDirection">
                            <div class="col-xs-12">
                                @if (Model.Count() > 0)
                                {
                                    <table id="example1" class="table table-bordered table-striped">
                                        <thead>
                                            <tr>
                                                <th>#</th>
                                                <th>@SharedLocalize.GetLocalizedStringValue("img")</th>
                                                <th>@SharedLocalize.GetLocalizedStringValue("ProductName") </th>
                                                <th>@SharedLocalize.GetLocalizedStringValue("Likes")</th>
                                                <th>@SharedLocalize.GetLocalizedStringValue("Actions")</th>

                                            </tr>
                                        </thead>
                                        <tbody>

                                            @{
                                                var i = 0;
                                            }
                                            @foreach (var item in Model)
                                            {
                                                if (item != null)
                                                {


                                                    i += 1;
                                                    <tr>
                                                        <td>@i</td>
                                                        <td style="width:40%;"><img src="@item.ImageProduct" style="width:15%;" /></td>
                                                        <td>@item.ProductName</td>
                                                        <td>@item.NumLike</td>
                                                        <td>
                                                            <a data-toggle="tooltip" data-placement="bottom" title=" @SharedLocalize.GetLocalizedStringValue("edit")" href="/Products/Edit/@item.Id" class="badge bg-light-blue-gradient"><i class="fa fa-eye" aria-hidden="true"></i></a>
                                                        </td>
                                                    </tr>


                                                }
                                            }
                                        </tbody>
                                    </table>
                                }
                                else
                                {
                                    <div class="col-xs-12 @(lang == "ar"?"text-right":"text-left")">
                                        @SharedLocalize.GetLocalizedStringValue("NoRecordfound").
                                    </div>
                                }

                            </div>
                        </div>
                    </div>
                    <!-- /.box-body -->
                </div>
                <!-- /.box -->
            </div>
            <!-- /.col -->
        </div>
        @if (Model.Count >= 10)
        {
            <Pagination MetaData="MetaData" Spread="2" SelectedPage="SelectedPage" />
        }
    </section>
}
@code {
    [Parameter]
    public string search { get; set; }
    [Parameter]
    public string lang { get; set; }

    private PostsParameters _PostsParameters = new PostsParameters();
     public List<ProductDto> Model { get; set; }
    public MetaData MetaData { get; set; } = new MetaData();

    [CascadingParameter]
    private Task<AuthenticationState> authenticationState { get; set; }
   

   
    protected override async Task OnInitializedAsync()
    {
        lang = await _homeBL.GetDefaultLanugage();
        await GetLikedProducts();
    }
    private async Task SelectedPage(int page)
    {
        _PostsParameters.PageNumber = page;
        await GetLikedProducts();
    }
    async Task GetLikedProducts()
    {
        var pagingResponse = await _productBL.GetProductsCP(3, search, null, lang, _PostsParameters);
        Model = pagingResponse.ToList();
        MetaData = pagingResponse.MetaData;
    }
}
