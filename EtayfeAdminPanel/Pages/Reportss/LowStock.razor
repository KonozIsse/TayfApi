@page "/Reports/LowStock"

<PageTitle>@SharedLocalize.GetLocalizedStringValue("LowofStock") | @SharedLocalize.GetLocalizedStringValue("ControlPanel")</PageTitle>


<section class="content-header">
    <h1>@SharedLocalize.GetLocalizedStringValue("LowofStock")<small> @SharedLocalize.GetLocalizedStringValue("LowofStock")</small> </h1>
    <ol class="breadcrumb">
        <li class="fa fa-dashboard">@SharedLocalize.GetLocalizedStringValue("dashboard")</li>
        <li class="active">@SharedLocalize.GetLocalizedStringValue("LowofStock") </li>
    </ol>
</section>
<!-- Main content -->
@if(Model != null)
{
<section class="content" id="html_table2">
    <!-- Info boxes -->
    <!-- /.row -->

    <div class="row">
        <div class="col-md-12">
            <div class="box">
                <div class="box-header">
                    <h3 class="box-title">@SharedLocalize.GetLocalizedStringValue("products") </h3>

                </div>
                <div class="box-header">
                    <div class="container-fluid">
                        <div class="row">
                        </div>
                    </div>
                </div>
                <div class="col-lg-6 form-inline" id="contact-form">
                    <form class="registration" method="get">
                        <div class="input-group-form search-panel ">

                            <input type="text" class="form-control input-group-form" placeholder="@SharedLocalize.GetLocalizedStringValue("search")" @bind-value="@search" />
                                <button type="button" class="btn btn-primary" @onclick="@GetLowInventory"><i class="oi oi-magnifying-glass"></i></button>

                            <a onClick="window.location.reload()" type="button" style="display:inline-block; width: auto; margin-top: 0;" class="btn btn-default"><i class="fa fa-refresh"></i></a>
                         
                        </div>
                    </form>
                    <div class="col-lg-4 form-inline" id="contact-form12"></div>
                </div>

                <!-- /.box-header -->
                <div class="box-body">
                        <div class="row">
                            <div class="col-xs-12">
                            </div>
                        </div>
                        <div class="row tableDirection">
                        <div class="col-xs-12">
                            @if (Model.Count() > 0)
                            {
                                    <table id="example1" class="table table-bordered table-striped">
                                    <thead>
                                        <tr>
                                            <th>#</th>
                                            <th>@SharedLocalize.GetLocalizedStringValue("Availability")</th>
                                            <th>@SharedLocalize.GetLocalizedStringValue("ProductName") </th>
                                            <th>@SharedLocalize.GetLocalizedStringValue("viewStock")</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                            @{
                                                var i = 0;
                                            }
                                        @foreach (var item in Model)
                                        {
                                                i += 1;
                                            <tr>
                                                <td>@i</td>
                                                <td>@item.Stock</td>
                                                <td>@item.ProductName</td>

                                                <td>
                                                    <a data-toggle="tooltip" data-placement="bottom" title=" @SharedLocalize.GetLocalizedStringValue("viewStock")" href="/Reports/ViewLowStock/@item.ProductId" class="badge bg-light-blue-gradient"><i class="fa fa-eye" aria-hidden="true"></i></a>
                                                   </td>
                                            </tr>
                                        }

                                    </tbody>
                                </table>
                            }
                            else
                            {
                                <div class="col-xs-12 @(lang == "ar"?"text-right":"text-left")">
                                    @SharedLocalize.GetLocalizedStringValue("NoRecordfound").
                                </div>
                            }

                        </div>
                    </div>
                </div>
                <!-- /.box-body -->
            </div>
            <!-- /.box -->
        </div>
        <!-- /.col -->
    </div>

    <!-- /.row -->

    <div class="modal fade" id="notificationModal" tabindex="-1" role="dialog" aria-labelledby="notificationModalLabel">
        <div class="modal-dialog" role="document">
            <div class="modal-content notificationContent">
            </div>
        </div>
    </div>
        @if (Model.Count >= 10)
        {
            <Pagination MetaData="MetaData" Spread="2" SelectedPage="SelectedPage" />
        }
    <!-- Main row -->
    <!-- /.row -->
</section>
}
@code {

    [Parameter]
    public string search { get; set; }
    public string lang { get; set; }

    public List<InventoryDto> Model { get; set; }
    public MetaData MetaData { get; set; } = new MetaData();
    private PostsParameters _PostsParameters = new PostsParameters();

    protected override async Task OnInitializedAsync()
    {
        http.DefaultRequestHeaders.Add("Accept", "application/json");
        lang = await http.GetFromJsonAsync<string>("api/Language/GetDefaultLanugage");
        await GetLowInventory();
    }
    private async Task SelectedPage(int page)
    {
        _PostsParameters.PageNumber = page;
        await GetLowInventory();
    }
    async Task GetLowInventory()
    {
        var pagingResponse = await _productBL.GetAllInventory(search,3, lang, _PostsParameters);
        Model = pagingResponse.ToList();
        MetaData = pagingResponse.MetaData;
    }


}