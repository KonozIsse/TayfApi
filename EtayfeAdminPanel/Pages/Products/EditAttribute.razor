@page "/Product/EditAttr/{Id:int}"

<PageTitle>@SharedLocalize.GetLocalizedStringValue("editattr") | @SharedLocalize.GetLocalizedStringValue("ControlPanel")</PageTitle>

<section class="content-header">
    <h1>@SharedLocalize.GetLocalizedStringValue("DefaultOptions")<small>@SharedLocalize.GetLocalizedStringValue("editattr")</small> </h1>
    <ol class="breadcrumb">
        <li class="fa fa-dashboard">@SharedLocalize.GetLocalizedStringValue("dashboard")</li>
        <li class="fa fa-users">@SharedLocalize.GetLocalizedStringValue("products")</li>
        <li class="active">@SharedLocalize.GetLocalizedStringValue("editattr")</li>
    </ol>
</section>

<!-- Main content -->
<section class="content">
    <div class="row">
        <div class="col-md-12">
            <div class="box">
                <div class="box-header">
                    <h3 class="box-title">@SharedLocalize.GetLocalizedStringValue("editattr")</h3>
                </div>

                <!-- /.box-header -->
                <div class="box-body">
                    <div class="row">
                        <div class="col-xs-12">
                            <div class="box box-info">
                                <br>
                                <EditForm Model="create" OnValidSubmit="UpdateAttributeProduct">
                                    <div class="form-horizontal">
                                        <div class="row">
                                            <div class="form-group">
                                                <label class="col-sm-2 col-md-3 control-label">@SharedLocalize.GetLocalizedStringValue("OptionName")<span style="color:red;">*</span></label>
                                                <div class="col-sm-10 col-md-4">
                                                    <InputSelect class="form-control"  @bind-Value="create.OptionId">
                                                        <option value="">@SharedLocalize.GetLocalizedStringValue("OptionName")</option>
                                                        @if(options != null)
                                                        {
                                                            @foreach (var c in options)
                                                            {
                                                                <option value="@c.Id">@c.OptionName</option>
                                                            }
                                                        }
                                                    </InputSelect>
                                                    <ValidationMessage For="@(() => create.OptionId)" />
                                                    <span class="help-block" style="font-weight: normal;font-size: 11px;margin-bottom: 0;">
                                                        @SharedLocalize.GetLocalizedStringValue("OptionName")
                                                    </span>
                                                </div>
                                            </div>

                                            <div class="form-group">
                                                <label for="option" class="col-sm-2 col-md-3 control-label">@SharedLocalize.GetLocalizedStringValue("OptionValue")</label>
                                                <div class="col-sm-10 col-md-4">
                                                    <InputSelect class="form-control" @onclick="(async ()=> await GetAllValues(create.OptionId))" @bind-Value="create.ValueId">
                                                        <option value="">@SharedLocalize.GetLocalizedStringValue("OptionName")</option>
                                                        @if (values != null)
                                                        {
                                                            @foreach (var c in values)
                                                            {
                                                                <option value="@c.Id">@c.OptionValueName</option>
                                                            }
                                                        }

                                                    </InputSelect>
                                                    <ValidationMessage For="@(() => create.ValueId)" />

                                                    <span class="help-block" style="font-weight: normal;font-size: 11px;margin-bottom: 0;">@SharedLocalize.GetLocalizedStringValue("OptionValue")</span>
                                                </div>
                                            </div>

                                            <div class="form-group">
                                                <label for="name" class="col-sm-2 col-md-3 control-label">@SharedLocalize.GetLocalizedStringValue("price")</label>
                                                <div class="col-xs-2 col-sm-1" style="padding-right: 0 !important;">
                                                    <InputSelect class="form-control" @bind-Value="create.PricePrefix">
                                                        <option value="+">+</option>
                                                        <option value="-">-</option>
                                                    </InputSelect>
                                                    <ValidationMessage For="@(() => create.PricePrefix)" />
                                                </div>

                                                <div class="col-xs-4 col-sm-4 col-md-3">
                                                    <InputNumber class="form-control" @bind-Value="create.AttributePrice"></InputNumber>
                                                    <ValidationMessage For="@(() => create.AttributePrice)" />
                                                    <span class="help-block" style="font-weight: normal;font-size: 11px;margin-bottom: 0;">Please enter numeric value only.</span>
                                                </div>
                                            </div>


                                        </div>


                                        <div class="box-footer text-center">
                                            <button type="submit" class="btn btn-primary">@SharedLocalize.GetLocalizedStringValue("Submit")</button>
                                            <a class="btn btn-defult" href="/Products"> @SharedLocalize.GetLocalizedStringValue("back")</a>
                                        </div>

                                    </div>
                                </EditForm>
                            </div>

                        </div>
                    </div>

                </div>
                <!-- /.box-body -->
            </div>
            <!-- /.box -->
        </div>
        <!-- /.col -->
    </div>
</section>

@code {

    [Parameter]
    public int Id { get; set; }
    UpdateAttributeDto create = new UpdateAttributeDto();
    public List<OptionDto> options { get; set; }
    public List<ValueDto> values { get; set; }
    string message;
    string style;
    protected override async Task OnInitializedAsync()
    {
        create = new UpdateAttributeDto();
        options = await _productBL.GetOptions();
    }

    async Task UpdateAttributeProduct()
    {
        create.Id = Id;
        var result = await _productBL.UpdateAttribute(create);
        if (result.Success)
        {
            message = result.Message;
            style = "success";
        }
        else
        {
            message = result.Message;
            style = "danger";
        }
    }

    public async Task GetAllValues(int id)
    {
        values = await _productBL.GetAllValuesToOption(id);
    }
}