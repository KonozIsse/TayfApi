@page "/Currencies"
<PageTitle>@SharedLocalize.GetLocalizedStringValue("currency")| @SharedLocalize.GetLocalizedStringValue("ControlPanel")</PageTitle>

<section class="content-header">
    <h1>  @SharedLocalize.GetLocalizedStringValue("currency")<small>@SharedLocalize.GetLocalizedStringValue("currency")</small> </h1>
    <ol class="breadcrumb">
        <li class="fa fa-dashboard">@SharedLocalize.GetLocalizedStringValue("dashboard")</li>
        <li class="active"> @SharedLocalize.GetLocalizedStringValue("currency")</li>
    </ol>
</section>
@if(Model != null)
{
    <section class="content">
        <!-- Info boxes -->
        <!-- /.row -->
        <div class="row">
            <div class="col-md-12">
                <div class="box">
                    <div class="box-header">

                        <div class="box-tools pull-right">
                            <a href="/Currency/Add" type="button" style="display:inline-block; width: auto; margin-top: 0;" class="btn btn-block btn-primary">@SharedLocalize.GetLocalizedStringValue("addCurrency")</a>
                        </div>
                    </div>
                    <br />

                    <!-- /.box-header -->
                    <div class="box-body">
                        <div class="row">
                            <div class="col-xs-12">
                            </div>
                        </div>


                        <div class="row">
                            <div class="col-xs-12 table-responsive">
                                @if (Model.Count() > 0)
                                {
                                    <table id="example1" class="table table-bordered table-striped">
                                        <thead>
                                            <tr>
                                                <th> #</th>
                                                <th>@SharedLocalize.GetLocalizedStringValue("mainTitle")</th>
                                                <th>@SharedLocalize.GetLocalizedStringValue("symbol")</th>
                                                <th>@SharedLocalize.GetLocalizedStringValue("position")</th>
                                                <th>@SharedLocalize.GetLocalizedStringValue("DecimalPlaces")</th>
                                                <th>@SharedLocalize.GetLocalizedStringValue("Value")</th>
                                                <th>@SharedLocalize.GetLocalizedStringValue("status")</th>
                                                <th>@SharedLocalize.GetLocalizedStringValue("Actions")</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @{
                                                var i = 0;
                                            }
                                            @foreach (var item in Model)
                                            {

                                                i += 1;
                                                <tr>
                                                    <td>
                                                        @i
                                                        @if (item.IsDefault == 1)
                                                        {
                                                            <span class="label label-success">@SharedLocalize.GetLocalizedStringValue("Default")</span>
                                                        }
                                                    </td>
                                                    <td>@item.Name</td>
                                                    <td>@item.Symbol</td>
                                                    <td>@item.Position </td>
                                                    <td>@item.DecimalPlaces</td>
                                                    <td>@item.Value</td>
                                                    <td>

                                                        <span class="label label-success">@item.IsStatus </span>

                                                    </td>
                                                    <td>
                                                        <a data-toggle="tooltip" data-placement="bottom" title=" @item.Name" href="/Currency/Edit/@item.Id" class="badge bg-light-blue"><i class="fa fa-pencil-square-o" aria-hidden="true"></i></a>
                                                        @if (item.IsDefault != 1)
                                                        {
                                                            <a  title=" @item.Name" @onclick="(async()=> await Delete(item))" class="badge bg-danger"><i class="fa fa-trash" aria-hidden="true"></i></a>

                                                        }
                                                    </td>

                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                }
                                else
                                {
                                    <div class="col-xs-12 @(lang == "ar"?"text-right":"text-left")">
                                        @SharedLocalize.GetLocalizedStringValue("NoRecordfound").
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                    <!-- /.box-body -->
                </div>
                <!-- /.box -->
            </div>
            <!-- /.col -->

        </div>
        @if (Model.Count() >= 10)
        {
            <Pagination MetaData="MetaData" Spread="2" SelectedPage="SelectedPage" />
        }
        
    </section>
}
<!--  content -->

@code {
    public string lang { get; set; }
    public List<CurrencyDto> Model { get; set; }
    public MetaData MetaData { get; set; } = new MetaData();
    private PostsParameters _PostsParameters = new PostsParameters();

    protected override async Task OnInitializedAsync()
    {
        http.DefaultRequestHeaders.Add("Accept", "application/json");
        lang = await http.GetFromJsonAsync<string>("api/Language/GetDefaultLanugage");
        await GetCurrencies();
    }
    private async Task SelectedPage(int page)
    {
        _PostsParameters.PageNumber = page;
        await GetCurrencies();
    }
    async Task GetCurrencies()
    {
        var pagingResponse = await _homeBL.GetAllCurrencies(lang, _PostsParameters);
        Model = pagingResponse.ToList();
        MetaData = pagingResponse.MetaData;
    }
    string message = "";
    string style = "";
    public async Task Delete(CurrencyDto customer)
    {
        var confirm = await js.confirMethod($"Are you sure ? ");
        @if (confirm)
        {
            var result = await _homeBL.DeleteCurrency(customer.Id);

            if (result.Success)
            {
                message = result.Message;
            }
            else
            {
                message = result.Message;
            }

        }
        NevigateToYourUrl();
    } 
    void NevigateToYourUrl()
    {
        NavigationManager.NavigateTo("/Currencies", true);
    }
   
}
