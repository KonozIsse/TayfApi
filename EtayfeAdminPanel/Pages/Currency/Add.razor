@page "/CP/Currency/Add"
@inject HomeBL _homeBL
@inject LocService SharedLocalize
@inject NavigationManager _navigationManager
<PageTitle>@SharedLocalize.GetLocalizedStringValue("addCurrency")|@SharedLocalize.GetLocalizedStringValue("ControlPanel")</PageTitle>

<Alert Message="@message" Style="@style"></Alert>

<section class="content-header">
    <h1>@SharedLocalize.GetLocalizedStringValue("currency")<small>@SharedLocalize.GetLocalizedStringValue("addCurrency")</small> </h1>
    <ol class="breadcrumb">
        <li class="fa fa-dashboard">@SharedLocalize.GetLocalizedStringValue("dashboard")</li>
        <li class="fa fa-users">@SharedLocalize.GetLocalizedStringValue("currency")</li>

        <li class="active">@SharedLocalize.GetLocalizedStringValue("addCurrency")</li>
    </ol>
</section>

<!-- Main content -->
<section class="content">
    <!-- Info boxes -->
    <!-- /.row -->

    <div class="row">
        <div class="col-md-12">
            <div class="box">
                <div class="box-header">
                    <h3 class="box-title">@SharedLocalize.GetLocalizedStringValue("addCurrency")</h3>
                </div>

                <!-- /.box-header -->
                <div class="box-body">
                    <div class="row">
                        <div class="col-xs-12">
                            <div class="box box-info">
                                <br>
                                    <div class="form-horizontal">
                                    <EditForm Model="@create" OnValidSubmit="@AddCurrency">
                                                <DataAnnotationsValidator />
                                        <div class="box-body">
                                            <div class="form-group">
                                                <label class="col-sm-2 col-md-3 control-label">
                                                    @SharedLocalize.GetLocalizedStringValue("title")
                                                    <span style="color:red;">*</span>

                                                </label>
                                                <div class="col-sm-10 col-md-4">

                                                    <InputText class="form-control" @bind-Value="create.Name" />
                                                   
                                                    <span class="help-block" style="font-weight: normal;font-size: 11px;margin-bottom: 0;">
                                                        <ValidationMessage For="@(() => create.Name)" />
                                                    </span>
                                                </div>
                                            </div>
                                            <div class="form-group">
                                                <label class="col-sm-2 col-md-3 control-label">
                                                    @SharedLocalize.GetLocalizedStringValue("title")<span style="color:red;">*</span>

                                                </label>
                                                <div class="col-sm-10 col-md-4">

                                                    <InputText class="form-control" @bind-Value="create.NameAr" />

                                                    <span class="help-block" style="font-weight: normal;font-size: 11px;margin-bottom: 0;">
                                                        <ValidationMessage For="@(() => create.NameAr)" />
                                                    </span>
                                                </div>
                                            </div>

                                            <div class="form-group">
                                                <label class="col-sm-2 col-md-3 control-label">@SharedLocalize.GetLocalizedStringValue("symbol")<span style="color:red;">*</span></label>
                                                <div class="col-sm-10 col-md-4">

                                                    <InputText class="form-control"  @bind-Value="create.Symbol" />

                                                    <span class="help-block" style="font-weight: normal;font-size: 11px;margin-bottom: 0;">
                                                        <ValidationMessage For="@(() => create.Symbol)" />
                                                    </span>
                                                </div>
                                            </div>



                                            <div class="form-group">
                                                <label class="col-sm-2 col-md-3 control-label">@SharedLocalize.GetLocalizedStringValue("position")<span style="color:red;">*</span></label>
                                                <div class="col-sm-10 col-md-4">
                                                    <InputSelect class="form-control" @bind-Value="create.Position">
                                                        <option value="left">@SharedLocalize.GetLocalizedStringValue("left")</option>
                                                        <option value="right">@SharedLocalize.GetLocalizedStringValue("right")</option>
                                                    </InputSelect>
                                                </div>
                                            </div>

                                            <div class="form-group">
                                                <label class="col-sm-2 col-md-3 control-label">@SharedLocalize.GetLocalizedStringValue("DecimalPlaces")<span style="color:red;">*</span></label>
                                                <div class="col-sm-10 col-md-4">
                                                    <InputText class="form-control"  @bind-Value="create.DecimalPlaces" />
                                                  
                                                </div>
                                            </div>

                                            <div class="form-group">
                                                <label class="col-sm-2 col-md-3 control-label">@SharedLocalize.GetLocalizedStringValue("Value")<span style="color:red;">*</span></label>
                                                <div class="col-sm-10 col-md-4">
                                                    <InputNumber class="form-control" @bind-Value="create.Value" />
                                                </div>
                                            </div>

                                            <div class="form-group">
                                                <label class="col-sm-2 col-md-3 control-label">@SharedLocalize.GetLocalizedStringValue("status") </label>
                                                <div class="col-sm-10 col-md-4">
                                                    <InputSelect class="form-control"  @bind-Value="create.IsStatus">
                                                        <option value="@Status.Active">@SharedLocalize.GetLocalizedStringValue("active")</option>
                                                        <option value="@Status.NotActive">@SharedLocalize.GetLocalizedStringValue("notActive")</option>
                                                    </InputSelect>
                                                </div>
                                            </div>

                                            <div class="box-footer text-center">
                                                <button type="submit" class="btn btn-primary">@SharedLocalize.GetLocalizedStringValue("Submit")</button>
                                                <a href="/currency/Index" type="submit" class="btn btn-defult">@SharedLocalize.GetLocalizedStringValue("back")</a>
                                            </div>

                                        </div>
                                        </EditForm>
                                    </div>
                                
                            </div>
                        </div>

                    </div>
                    <!-- /.box-body -->
                </div>
                <!-- /.box -->
            </div>
            <!-- /.col -->
        </div>
    </div>

</section>

@code {

    public CreateCurrencyDto create { get; set; }

    protected override async Task OnInitializedAsync()
    {
        create = new CreateCurrencyDto();
    }
    string message = ""; 
    string style = "";
    async Task AddCurrency()
    {
        var result = await _homeBL.AddCurrency(create);
        if (result.Success)
        {
            message = result.Message;
            style = "success";
        }
        else
        {
            message = result.Message;
            style = "danger";
        }
    }
}
