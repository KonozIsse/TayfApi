@page "/Coupon/Add"
<PageTitle>@SharedLocalize.GetLocalizedStringValue("Coupons")|@SharedLocalize.GetLocalizedStringValue("ControlPanel")</PageTitle>

<Alert Message="@message" Style="@style"></Alert>
<style>
    .select2 {
        width: 330px !important;
    }
</style>
<section class="content-header">
    <h1>@SharedLocalize.GetLocalizedStringValue("Coupons")<small>@SharedLocalize.GetLocalizedStringValue("Coupons")</small> </h1>
    <ol class="breadcrumb">
        <li class = "fa fa-dashboard">
            @SharedLocalize.GetLocalizedStringValue("dashboard")
        </li>
        <li class="active">@SharedLocalize.GetLocalizedStringValue("Coupons")</li>
    </ol>
</section>

<!-- Main content -->
<section class="content">
    <!-- Info boxes -->
    <!-- /.row -->

    <div class="row">
        <div class="col-md-12">
            <div class="box">
                <div class="box-header">
                    <h3 class="box-title">@SharedLocalize.GetLocalizedStringValue("Coupons")</h3>
                </div>

                <!-- /.box-header -->
                <div class="box-body">
                    <div class="row">
                        <div class="col-xs-12">
                            <div class="box box-info">
                                <br>
                                  <EditForm Model="@create" OnValidSubmit="@AddCoupon">
                                                <DataAnnotationsValidator />
                                    <div class="form-horizontal">

                                        <!-- form start -->
                                        <div class="box-body">

                                            <div class="form-group">
                                                <label class="col-sm-2 col-md-3 control-label">@SharedLocalize.GetLocalizedStringValue("Coupon")<span style="color:red;">*</span></label>
                                                <div class="col-sm-10 col-md-4">
                                                    <InputText class="form-control" @bind-Value="create.CouponCode" />
                                                </div>
                                            </div>


                                            <div class="form-group">
                                                <label class="col-sm-2 col-md-3 control-label">@SharedLocalize.GetLocalizedStringValue("desc")</label>
                                                <div class="col-sm-10 col-md-4">
                                                    <InputTextArea class="form-control" @bind-Value="create.Description" />
                                                </div>
                                            </div>

                                            <div class="form-group">
                                                <label class="col-sm-2 col-md-3 control-label">@SharedLocalize.GetLocalizedStringValue("DiscountType") <span style="color:red;">*</span></label>
                                                <div class="col-sm-10 col-md-4">
                                                    <InputSelect class="form-control field-validate" style="display:block;"  @bind-Value="create.DiscountType">
                                                        <option value="@DiscountType.CartDiscount" selected="">@SharedLocalize.GetLocalizedStringValue("CartDiscount")</option>
                                                        <option value="@DiscountType.CartPercentDiscount">@SharedLocalize.GetLocalizedStringValue("Cart2Discount")</option>
                                                        <option value="@DiscountType.ProductDiscount">@SharedLocalize.GetLocalizedStringValue("ProductDiscount")</option>
                                                        <option value="@DiscountType.ProductPercentDiscount">@SharedLocalize.GetLocalizedStringValue("Product2Discount")</option>
                                                    </InputSelect>
                                                   
                                                </div>
                                            </div>

                                            <div class="form-group flst" >
                                                <label class="col-sm-2 col-md-3 control-label">@SharedLocalize.GetLocalizedStringValue("products")</label>
                                                <div class="col-sm-10 col-md-4 couponProdcuts">
                                                    <InputSelect class="form-control select2  select2-hidden-accessible" tabindex="-1" aria-hidden="true" @bind-Value="create.ProductsCoupons">
                                                        @if(products != null)
                                                        {
                                                            @foreach (var product in products)
                                                            {
                                                                <option value="@product.Id">@product.ProductName</option>
                                                            }
                                                        }
                                                    </InputSelect>

                                                    <span class="dropdown-wrapper" aria-hidden="true"></span>
                                                    <span class="help-block" style="font-weight: normal;font-size: 11px;margin-bottom: 0;">List of product the coupon can be used on.</span>
                                                </div>
                                            </div>


                                            <div class="form-group">
                                                <label class="col-sm-2 col-md-3 control-label">@SharedLocalize.GetLocalizedStringValue("CouponAmount")<span style="color:red;">*</span></label>
                                                <div class="col-sm-10 col-md-4">
                                                    <InputNumber class="form-control" @bind-Value="create.CouponAmount"></InputNumber>
                                                    
                                                </div>
                                            </div>

                                            <div class="form-group">
                                                <label class="col-sm-2 col-md-3 control-label">@SharedLocalize.GetLocalizedStringValue("CouponExpiryDate")</label>
                                                <div class="col-sm-10 col-md-4">
                                                    <InputDate class="form-control" @bind-Value="create.ExpiryDate"></InputDate>
                                                </div>
                                            </div>



                                            <div class="box-footer text-center">
                                                <button type="submit" class="btn btn-primary">@SharedLocalize.GetLocalizedStringValue("Submit")</button>
                                                <a href="/Coupons" type="submit" class="btn btn-defult">@SharedLocalize.GetLocalizedStringValue("back")</a>
                                            </div>

                                        </div>

                                    </div>
                                </EditForm>
                            </div>
                        </div>

                    </div>
                    <!-- /.box-body -->
                </div>
                <!-- /.box -->
            </div>
            <!-- /.col -->
        </div>
    </div>
    <!-- /.row -->
    <!-- Main row -->
    <!-- /.row -->
</section>


@code {
    public CreateCouponDto create { get; set; }
    private List<ProductDto> products;
    protected override async Task OnInitializedAsync()
    {
        create = new CreateCouponDto();
        products = await _orderBL.GetAllPrductsToCoupon();
    }
    string message = "";
    string style = "";
    async Task AddCoupon()
    {
        var result = await _orderBL.AddCoupon(create,2);
        if (result.Success)
        {
            message = result.Message;
            style = "success";
        }
        else
        {
            message = result.Message;
            style = "danger";
        }
    }
  
}


