@*@layout LoginLayout*@
@page "/Lo"
<style>
    input{
      text-align: left;
    }
    span{
        float:left;
    }
</style>

<div class="login-box">
    <div class="login-logo">

        <img style="width: 50%" src="/logo.png">

        <div style="font-size: 25px;"><b> Welcome</b>To Admin Panel</div>
    </div>
    <!-- /.login-logo -->
    <div class="login-box-body" style="padding: 30px !important;">
        <p class="login-box-msg">@SharedLocalize.GetLocalizedStringValue("Sign")</p>
<div class="form-horizontal">
 @if (user != null)
{
<EditForm Model="@user" OnValidSubmit="@OnVaild">
    
       
    <div class="form-group has-feedback">
        <InputText class="form-control col-12" @bind-Value="user.UserName" placeholder="email address" />
        <ValidationMessage For="@(() => user.UserName)" />
                    <span class="glyphicon glyphicon-lock form-control-feedback"></span>
    </div>
      <div class="form-group has-feedback">
             <InputText type="password" class="form-control col-12" @bind-Value="user.Password" placeholder="password" />
            <ValidationMessage For="@(() => user.Password)" />
                    <span class="glyphicon glyphicon-lock form-control-feedback"></span>
    </div>
    <div class="row">

        <!-- /.col -->
        <div>
            <input id="login" type="submit" value="Login" class="btn btn-primary btn-block btn-flat" />
        </div>
        <!-- /.col -->
    </div>
</EditForm>
                @if (!string.IsNullOrEmpty(message))
                {
                    <p>@message</p>
                }
}

</div>
</div>
</div>
