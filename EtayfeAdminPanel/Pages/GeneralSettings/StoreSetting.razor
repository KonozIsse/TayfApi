@page "/Setting/StoreSettings"
@page "/StoreSettings"
<PageTitle>@SharedLocalize.GetLocalizedStringValue("EditSetting") | @SharedLocalize.GetLocalizedStringValue("ControlPanel")</PageTitle>
<Alert Message="@message" Style="@style"></Alert>
<section class="content-header">
    <h1>@SharedLocalize.GetLocalizedStringValue("EditSetting")<small>@SharedLocalize.GetLocalizedStringValue("StoreSettings")</small> </h1>
    <ol class="breadcrumb">
        <li class="fa fa-dashboard">@SharedLocalize.GetLocalizedStringValue("dashboard")</li>
   <li class="active">@SharedLocalize.GetLocalizedStringValue("EditSetting")</li>
    </ol>
</section>

<!-- Main content -->
<section class="content">

    <!-- /.row -->
    <div class="row">
        <div class="col-md-12">
            <div class="box">
                <div class="box-header">
                    <h3 class="box-title">@SharedLocalize.GetLocalizedStringValue("StoreSettings")</h3>
                </div>

                <!-- /.box-header -->
                <div class="box-body">
                    <div class="row">
                        <div class="col-xs-12">
                            <div class="box box-info">

                                <div class="box-body">
                                    <EditForm Model="@create" OnValidSubmit="@EditSettingStore">
                                    <DataAnnotationsValidator />
                                        <div class="form-horizontal">

                                            <h4>@SharedLocalize.GetLocalizedStringValue("GoogleMapAPI")</h4>
                                            <hr>

                                            <div class="form-group">
                                            <label class="control-label col-md-3">@SharedLocalize.GetLocalizedStringValue("GoogleMapAPI")</label>
                                                <div class="col-md-8">
                                                <InputText class="form-control" @bind-Value="create.google_map_api"  ></InputText>
                                                    <ValidationMessage For="@(() => create.google_map_api)" />
                                                </div>
                                            </div>


                                            <hr>
                                            <h4>@SharedLocalize.GetLocalizedStringValue("Email")</h4>
                                            <hr>



                                            <div class="form-group">
                                            <label class="control-label col-md-3">@SharedLocalize.GetLocalizedStringValue("ContactUsEmail")</label>
                                                <div class="col-md-8">
                                                <InputText class="form-control" @bind-Value="create.contact_us_email" ></InputText>
                                                    <ValidationMessage For="@(() => create.contact_us_email)" />
                                                </div>
                                            </div>

                                            <hr>
                                            <h4>@SharedLocalize.GetLocalizedStringValue("OrderEmail")</h4>
                                            <hr>

                                            <div class="form-group">
                                            <label  class = "control-label col-md-3">@SharedLocalize.GetLocalizedStringValue("OrderEmail")</label>
                                                <div class="col-md-8">
                                                <InputText class="form-control"  @bind-Value="create.order_email"></InputText>
                                                    <ValidationMessage For="@(() => create.order_email)" />
                                                </div>
                                            </div>

                                            <hr>
                                            <h4>@SharedLocalize.GetLocalizedStringValue("WebsiteSettings")</h4>
                                            <hr>

                                            <div class="form-group">
                                                <label class="col-sm-2 col-md-3 control-label">@SharedLocalize.GetLocalizedStringValue("HidePrices")</label>
                                                <div class="col-sm-10 col-md-4">
                                                    <InputRadioGroup  @bind-Value="@create.hide_price" class="form-control col-sm-4">
                                                         <span> <InputRadio  Value="@trueVal" /> @SharedLocalize.GetLocalizedStringValue("Yes") </span>
                                                        <span> <InputRadio Value="@falseVal" /> @SharedLocalize.GetLocalizedStringValue("No") </span>
                                                    </InputRadioGroup>
                                                    <ValidationMessage For="@(() => create.hide_price)" />
                                                    <span class="help-block" style="font-weight: normal;font-size: 11px;margin-bottom: 0;margin-top: 0;">
                                                        hide all prices from website (yes)
                                                    </span>
                                                </div>
                                            </div>

                                            
                                            

                                            <div class="box-footer text-center">
                                            <button type="submit" class="btn btn-primary">@SharedLocalize.GetLocalizedStringValue("Submit")</button>
                                            <a class="btn btn-default" href="/Settings">@SharedLocalize.GetLocalizedStringValue("back")</a>
                                            </div>

                                        </div>
                                        </EditForm>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>

            </div>
            <!-- /.box-body -->
        </div>
        <!-- /.box -->
    </div>
</section>

@code {
    SettingStoreVM create = new SettingStoreVM();
    string message;
    string style; 
    string trueVal = "true";
    string falseVal = "false";
    protected override async Task OnInitializedAsync()
    {
        create = new SettingStoreVM();
        create = await _homeBL.GetSettingStore();

    }

    async Task EditSettingStore()
    {
        var result = await _homeBL.EditSettingStore(create);
        if (result.Success)
        {
            message = result.Message;
            style = "success";
        }
        else
        {
            message = result.Message;
            style = "danger";
        }
      //  NavigationManager.NavigateTo("/StoreSettings", true);
    }
}