@page "/CP/Page/Edit/{Id:int}"
<section class="content-header">
    <h1>@SharedLocalize.GetLocalizedStringValue("editStaticPage")<small>@SharedLocalize.GetLocalizedStringValue("editStaticPage")</small> </h1>
    <ol class="breadcrumb">
        <li class="fa fa-dashboard">@SharedLocalize.GetLocalizedStringValue("dashboard")</li>
        <li>@SharedLocalize.GetLocalizedStringValue("staticPages")</li>
        <li class="active">@SharedLocalize.GetLocalizedStringValue("editStaticPage")</li>
    </ol>
</section>

<!-- Main content -->
<section class="content">
    <!-- Info boxes -->
    <!-- /.row -->

    <div class="row">
        <div class="col-md-12">
            <div class="box">
                <div class="box-header">
                    <h3 class="box-title">@SharedLocalize.GetLocalizedStringValue("editStaticPage")</h3>
                </div>

                <!-- /.box-header -->
                <div class="box-body">
                    <div class="row">
                        <div class="col-xs-12">
                            <div class="box box-info">
                                <br>
                             @*   <EditForm Model="create" OnValidSubmit="@UpdatePage">
                                    <DataAnnotationsValidator />*@
                                    <div class="form-horizontal">
                                        <!-- form start -->
                                        <div class="box-body">

                                            <div class="row">
                                                @if(langs != null)
                                                {
                                                    @foreach (var m in langs)
                                                    {
                                                        <div class="form-group">
                                                            <label class="col-sm-2 col-md-3 control-label">@SharedLocalize.GetLocalizedStringValue("title") (@m.Code) </label>
                                                            <div class="col-md-8">
                                                                <input @onchange="@(c => create.Names[m.Code] = c.Value.ToString())" value=@create.Names  class="form-control"/>
                                                            </div>
                                                        </div>
                                                        <div class="form-group">
                                                            <label class="col-sm-2 col-md-3 control-label">@SharedLocalize.GetLocalizedStringValue("desc") (@m.Code)  </label>
                                                            <div class="col-sm-10 col-md-8">
                                                            <textarea @onchange="@(c => create.Descriptions[m.Code] = c.Value.ToString())" value=@create.Descriptions></textarea>
                                                            </div>
                                                        </div>
                                                    }
                                                }
                                               
                                                <div class="box-footer text-center">
                                                <button type="submit" class="btn btn-primary" @onclick="UpdatePage">@SharedLocalize.GetLocalizedStringValue("Submit")</button>
                                                <a href="/CP/Pages" type="submit" class="btn btn-default"> @SharedLocalize.GetLocalizedStringValue("back")</a>
                                                </div>

                                            </div>



                                        </div>
                                    </div>

                                @*</EditForm>*@
                            </div>

                        </div>
                        <!-- /.box-body -->
                    </div>
                    <!-- /.box -->
                </div>
                <!-- /.col -->
            </div>
        </div>
    </div>
    <!-- /.row -->
    <!-- Main row -->
    <!-- /.row -->
</section>
@code {
    [Parameter]
    public int Id { get; set; }
    [Parameter]
    public string lang { get; set; }
    public List<LanguageDto> langs;
    EditPageDto create = new EditPageDto();
    string message;
    string style;
    protected override async Task OnInitializedAsync()
    {
        create = new EditPageDto();
        //if (Id != 0)
        //{
        //    create = await _homeBL.GetAllPages(Id);
        //}
        lang = await _homeBL.GetDefaultLanugage();
        langs = await _homeBL.GetLanguages(lang);
    }

    async Task UpdatePage()
    {
        create.Id = Id;
        var result = await _homeBL.EditPage(create);
        if (result.Success)
        {
            message = result.Message;
            style = "success";
        }
        else
        {
            message = result.Message;
            style = "danger";
        }
    }
}
