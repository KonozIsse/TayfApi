@page "/Setting/Edit"
<PageTitle>@SharedLocalize.GetLocalizedStringValue("EditSetting") | @SharedLocalize.GetLocalizedStringValue("ControlPanel")</PageTitle>
<section class="content-header">
    <h1>@SharedLocalize.GetLocalizedStringValue("EditSetting")<small>@SharedLocalize.GetLocalizedStringValue("EditSetting")</small> </h1>
    <ol class="breadcrumb">
        <li class="fa fa-dashboard">@SharedLocalize.GetLocalizedStringValue("dashboard")</li>
  <li class="active">@SharedLocalize.GetLocalizedStringValue("EditSetting")</li>
    </ol>
</section>


<section class="content">
    <!-- Info boxes -->
    <!-- /.row -->

    <div class="row">
        <div class="col-md-12">
            <div class="box">
                <div class="box-header">
                    <h3 class="box-title">@SharedLocalize.GetLocalizedStringValue("EditSetting")</h3>
                </div>

                <!-- /.box-header -->
                <div class="box-body">
                    <div class="row">
                        <div class="col-xs-12">
                            <div class="box box-info">
                                <br>
                                <EditForm Model="create" OnValidSubmit="UpdateSetting">

                                    <div class="form-horizontal">
                                        <div class="box-body">

                                            <div class="row">
                                                <div class="form-group">
                                                    <label class="col-sm-2 col-md-3 control-label">@SharedLocalize.GetLocalizedStringValue("ContactUsEmail")</label>
                                                    <div class="col-md-8">
                                                    <InputText class="form-control" @bind-Value="create.contact_us_email"></InputText>
                                                    <ValidationMessage For="@(() =>create.contact_us_email )" />
                                                        </div>
                                                </div>

                                                <div class="form-group">
                                                    <label class="col-sm-2 col-md-3 control-label">@SharedLocalize.GetLocalizedStringValue("Address")</label>
                                                    <div class="col-md-8">
                                                        <InputText class="form-control" @bind-Value="create.address"></InputText>
                                                        <ValidationMessage For="@(() =>create.address )" />
                                                    </div>
                                                </div>

                                                <div class="form-group">
                                                    <label class="col-sm-2 col-md-3 control-label">@SharedLocalize.GetLocalizedStringValue("Name")</label>
                                                    <div class="col-md-8">
                                                        <InputText class="form-control" @bind-Value="create.app_name"></InputText>
                                                        <ValidationMessage For="@(() =>create.app_name )" />
                                                    </div>
                                                </div>

                                                <div class="form-group">
                                                    <label class="col-sm-2 col-md-3 control-label">@SharedLocalize.GetLocalizedStringValue("Facebook")</label>
                                                    <div class="col-md-8">
                                                        <InputText class="form-control" @bind-Value="create.facebook_url"></InputText>
                                                        <ValidationMessage For="@(() =>create.facebook_url )" />
                                                    </div>
                                                </div>

                                                <div class="form-group">
                                                    <label class="col-sm-2 col-md-3 control-label">@SharedLocalize.GetLocalizedStringValue("Twitter")</label>
                                                    <div class="col-md-8">
                                                        <InputText class="form-control" @bind-Value="create.twitter_url"></InputText>
                                                        <ValidationMessage For="@(() =>create.twitter_url )" />
                                                    </div>
                                                </div>
                                                <div class="form-group">
                                                    <label class="col-sm-2 col-md-3 control-label">@SharedLocalize.GetLocalizedStringValue("instagram")</label>
                                                    <div class="col-md-8">
                                                        <InputText class="form-control" @bind-Value="create.instagram_url"></InputText>
                                                        <ValidationMessage For="@(() =>create.instagram_url )" />
                                                    </div>
                                                </div>
                                                <div class="form-group">
                                                        <label class="col-sm-2 col-md-3 control-label">@SharedLocalize.GetLocalizedStringValue("yout")</label>
                                                        <div class="col-md-8">
                                                            <InputText class="form-control" @bind-Value="create.youtube_link"></InputText>
                                                            <ValidationMessage For="@(() =>create.youtube_link )" />
                                                        </div>
                                                        </div>
                                                
                                                <div class="form-group">
                                                <label class="col-sm-2 col-md-3 control-label">@SharedLocalize.GetLocalizedStringValue("whatsapp")</label>
                                                <div class="col-md-8">
                                                    <InputText class="form-control" @bind-Value="create.whatsApp"></InputText>
                                                    <ValidationMessage For="@(() =>create.whatsApp )" />
                                                </div>
                                                </div>
                                                <div class="form-group">
                                                    <label class="col-sm-2 col-md-3 control-label">@SharedLocalize.GetLocalizedStringValue("City")</label>
                                                <div class="col-md-8">
                                                    <InputText class="form-control" @bind-Value="create.city"></InputText>
                                                    <ValidationMessage For="@(() =>create.city )" />
                                                </div>
                                                </div>
                                                <div class="form-group">
                                                    <label class="col-sm-2 col-md-3 control-label">@SharedLocalize.GetLocalizedStringValue("openTime")</label>
                                                  <div class="col-md-8">
                                                    <InputText class="form-control" @bind-Value="create.open_time"></InputText>
                                                    <ValidationMessage For="@(() =>create.open_time )" />
                                                </div>
                                                </div>
                                                <div class="form-group">
                                                    <label class="col-sm-2 col-md-3 control-label">@SharedLocalize.GetLocalizedStringValue("closeTime")</label>
                                                <div class="col-md-8">
                                                    <InputText class="form-control" @bind-Value="create.close_time"></InputText>
                                                    <ValidationMessage For="@(() =>create.close_time )" />
                                                </div>
                                                </div>
                                                <div class="form-group">
                                                    <label class="col-sm-2 col-md-3 control-label">@SharedLocalize.GetLocalizedStringValue("Country")</label>
                                                <div class="col-md-8">
                                                    <InputText class="form-control" @bind-Value="create.country"></InputText>
                                                    <ValidationMessage For="@(() =>create.country )" />
                                                </div>
                                                </div>

                                                <div class="form-group">
                                                <label class="col-sm-2 col-md-3 control-label">Android Invite Link</label>
                                                <div class="col-md-8">
                                                    <InputText class="form-control" @bind-Value="create.android_app_link"></InputText>
                                                    <ValidationMessage For="@(() =>create.android_app_link )" />
                                                </div>
                                                </div>

                                                <div class="form-group">
                                                    <label class="col-sm-2 col-md-3 control-label">iOS Invite Link</label>
                                                    <div class="col-md-8">
                                                        <InputText class="form-control" @bind-Value="create.ios_app_link"></InputText>
                                                        <ValidationMessage For="@(() =>create.ios_app_link )" />
                                                    </div>
                                                </div>
                                                </div>
                                                <div class="form-group">
                                            <label class="col-sm-2 col-md-3 control-label">@SharedLocalize.GetLocalizedStringValue("Mobile")</label>
                                            <div class="col-md-8">
                                                <InputText class="form-control" @bind-Value="create.phone_no"></InputText>
                                                <ValidationMessage For="@(() =>create.ios_app_link )" />
                                            </div>
                                                </div>
                                                <div class="form-group" id="imageIcone">
                                                    <label class="col-sm-2 col-md-3 control-label">@SharedLocalize.GetLocalizedStringValue("logoWebsite")<span style="color:red;">*</span></label>
                                                    <div class="col-sm-10 col-md-4">
                                                        <!-- Modal -->
                                                        <div class="modal fade embed-images" id="ModalmanufacturedICone" tabindex="-1" role="dialog" aria-labelledby="myModalLabel">
                                                            <div class="modal-dialog" role="document">
                                                                <div class="modal-content">
                                                                    <div class="modal-header">
                                                                        <button type="button" class="close" data-dismiss="modal" id="closemodal" aria-label="Close"><span aria-hidden="true">×</span></button>
                                                                        <h3 class="modal-title text-primary" id="myModalLabel">Choose Image</h3>
                                                                    </div>
                                                                    <div class="modal-body manufacturer-image-embed">
                                                                    </div>
                                                                    <div class="modal-footer">
                                                                        <a href="/Media"target="_blank" class="btn btn-primary pull-left">@SharedLocalize.GetLocalizedStringValue("addImg")</a>
                                                                        <a class="btn btn-default refresh-image shownotify newIcon" id="reff"><i class="fa fa-refresh"></i></a>
                                                                        <button type="button" class="btn btn-success" id="selectedICONE" data-dismiss="modal">@SharedLocalize.GetLocalizedStringValue("add")</button>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div id="imageselected">
                                                            <input value="Others" hidden id="typeImg" />
                                                            <a id="newIcon" data-id="1" class="newIcon btn btn-primary field-validate" data-toggle="modal" data-target="#ModalmanufacturedICone" type="button">@SharedLocalize.GetLocalizedStringValue("addImg")</a>
                                                            <br>
                                                            <div id="selectedthumbnailIcon" class="selectedthumbnail col-md-5"> </div>
                                                            <div class="closimage">
                                                                <button type="button" class="close pull-left image-close " id="image-Icone" style="display: none; position: absolute;left: 105px; top: 54px; background-color: black; color: white; opacity: 2.2; " aria-label="Close">
                                                                    <span aria-hidden="true">×</span>
                                                                </button>
                                                            </div>
                                                        </div>
                                                        <br />
                                                        @*<input value="@img"/>*@
                                                        <br />
                                                        <img id="imgCont" width="80px" src="">
                                                        <span class="help-block" style="font-weight: normal;font-size: 11px;margin-bottom: 0;">@SharedLocalize.GetLocalizedStringValue("UploadYourImages")</span>

                                                        <br>
                                                    </div>
                                                </div>


                                                <div class="box-footer text-center">
                                                    <button type="submit" class="btn btn-primary">@SharedLocalize.GetLocalizedStringValue("Submit")</button>
                                                    <a class="btn btn-defult" href="/Settings">@SharedLocalize.GetLocalizedStringValue("back")</a>
                                                </div>
                                            </div>
                                        </div>
                                </EditForm>

                            </div>
                        </div>
                    </div>
                </div>
            </div> 
            </div>
            </div>
</section>
@code {
    [Parameter]
    public string lang { get; set; }
    SettingVM create = new SettingVM();
    string message;
    string style;
    protected override async Task OnInitializedAsync()
    {
        create = new SettingVM();
        http.DefaultRequestHeaders.Add("Accept", "application/json");
        lang = await http.GetFromJsonAsync<string>("api/Language/GetDefaultLanugage");
    }
    async Task UpdateSetting()
    {
        var result = await _homeBL.EditSetting(create);
        if (result.Success)
        {
            message = result.Message;
            style = "success";
        }
        else
        {
            message = result.Message;
            style = "danger";
        }
    }
}
