 @page "/Settings"
<PageTitle>@SharedLocalize.GetLocalizedStringValue("Setting") | @SharedLocalize.GetLocalizedStringValue("ControlPanel")</PageTitle>

<section class="content-header">
 <h1>  @SharedLocalize.GetLocalizedStringValue("Setting") <small>Listing All The @SharedLocalize.GetLocalizedStringValue("Setting").</small> </h1>
    <ol class="breadcrumb">
        <li class="fa fa-dashboard">@SharedLocalize.GetLocalizedStringValue("dashboard")</li>
        <li class="active"> @SharedLocalize.GetLocalizedStringValue("Setting") </li>
    </ol>
</section>
@if(Model != null)
{
<!--  content -->
<section class="content">
    <!-- Info boxes -->
    <!-- /.row -->
    <div class="row">
        <div class="col-md-12">
            <div class="box">
                <div class="box-header">
                    <div class="box-header">
                        <div class="page-toolbar">
                            <div class="btn-group pull-right">

                                <a style="text-transform:unset;" href="/Setting/Edit" class="btn btn-success pull-right">
                                    <i class="fa fa-edit"></i>
                                    @SharedLocalize.GetLocalizedStringValue("EditSetting")
                                </a>
                            </div>
                        </div>
                    </div>

                </div>

                <!-- /.box-header -->
                <div class="box-body">
                    <div class="row">
                        <div class="col-xs-12">
                        </div>
                    </div>


                    <div class="row">
                        <div class="col-xs-12">
                            @if (Model.Count() > 0)
                            {
                                <table id="example1" class="table table-bordered table-striped">
                                    <thead>
                                        <tr>
                                            <th> #</th>
                                            <th>@SharedLocalize.GetLocalizedStringValue("title")</th>
                                            <th>@SharedLocalize.GetLocalizedStringValue("Value")</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{
                                            var i = 0;
                                        }
                                        @foreach (var item in Model)
                                        {

                                            i += 1;

                                            <tr>
                                                <td>@i</td>
                                                <td>@item.Key</td>
                                                <td>@((MarkupString)item.Value)</td>


                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }
                            else
                            {
                                <div class="col-xs-12 @(lang == "ar"?"text-right":"text-left")">
                                    @SharedLocalize.GetLocalizedStringValue("NoRecordfound")..
                                </div>
                            }
                        </div>
                    </div>
                </div>
                <!-- /.box-body -->
            </div>
            <!-- /.box -->
        </div>
        <!-- /.col -->
    </div>
</section>
}
@code {
    string lang = "";

    public List<SettingDto> Model { get; set; }

    protected override async Task OnInitializedAsync()
    {
        http.DefaultRequestHeaders.Add("Accept", "application/json");
        lang = await http.GetFromJsonAsync<string>("api/Language/GetDefaultLanugage");
        Model = await http.GetFromJsonAsync<List<SettingDto>>("api/Settings/getSettings");
    }
    void NevigateToYourUrl()
    {
        NavigationManager.NavigateTo("/Settings", true);
    }
}