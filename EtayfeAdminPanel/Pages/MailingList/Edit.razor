@page "/MailingList/Edit/"
@page "/MailingList/Edit/{id:int}"
@inject HomeBL _homeBL
@inject LocService SharedLocalize
@inject NavigationManager _navigationManager

<PageTitle>@SharedLocalize.GetLocalizedStringValue("EditEmailMessage")|@SharedLocalize.GetLocalizedStringValue("ControlPanel")</PageTitle>

<Alert Message="@message" Style="@style"></Alert>
<section class="content-header">
    <h1>@SharedLocalize.GetLocalizedStringValue("EditEmailMessage")<small>@SharedLocalize.GetLocalizedStringValue("EditEmailMessage")</small> </h1>
    <ol class="breadcrumb">
        <li class ="fa fa-dashboard"> @SharedLocalize.GetLocalizedStringValue("dashboard") </li>
        <li class="fa fa-users">@SharedLocalize.GetLocalizedStringValue("EmailList")</li>
        <li class="active">@SharedLocalize.GetLocalizedStringValue("EditEmailMessage")</li>
    </ol>
</section>

<!-- Main content -->
<section class="content">
    <!-- Info boxes -->
    <!-- /.row -->

    <div class="row">
        <div class="col-md-12">
            <div class="box">
                <div class="box-header">
                    <h3 class="box-title">@SharedLocalize.GetLocalizedStringValue("EditEmailMessage")</h3>
                </div>

                <!-- /.box-header -->
                <div class="box-body">
                    <div class="row">
                        <div class="col-xs-12">
                            <div class="box box-info">
                                <br>
                                    <div class="form-horizontal">
                                    <EditForm Model="@create" OnValidSubmit="@UpdateTemplate">
                                                <DataAnnotationsValidator />
                                        <div class="box-body">
                                            <div class="form-group">
                                                <label class="col-sm-2 col-md-3 control-label">@SharedLocalize.GetLocalizedStringValue("Subject")</label>
                                                <div class="col-md-4">
                                                    <InputText class="form-control " @bind-Value="create.Subject" />
                                                </div>
                                            </div>

                                            <div class="form-group">
                                                <label class="col-sm-2 col-md-3 control-label">@SharedLocalize.GetLocalizedStringValue("Message")</label>
                                                <div class="col-sm-10 col-md-4">
                                                    <InputTextArea class="form-control" cols="20" id="message" name="message" required="required" rows="6" @bind-Value="create.Message" />
                                                </div>
                                            </div>

                                            <div class="box-footer text-center">
                                                <button type="submit" class="btn btn-primary">@SharedLocalize.GetLocalizedStringValue("Submit")</button>
                                                <a @onclick="@NevigateToYourUrl" type="submit" class="btn btn-defult">@SharedLocalize.GetLocalizedStringValue("back")</a>
                                            </div>

                                        </div>
                                        </EditForm>
                                    </div>
                            </div>
                        </div>

                    </div>
                    <!-- /.box-body -->
                </div>
                <!-- /.box -->
            </div>
            <!-- /.col -->
        </div>
    </div>
</section>
@code {
    [Parameter]
    public int id { get; set; }
    UpdateTemplateDto create = new UpdateTemplateDto();
    string message;
    string style;
    string lang = "en";
    protected override async Task OnInitializedAsync()
    {
        create = new UpdateTemplateDto();
        create = await _homeBL.GetTemplateId(id);
    }

    async Task UpdateTemplate()
    {
        create.Id = id;
        var result = await _homeBL.UpdateTemplate(create);
        if (result.Success)
        {
            message = result.Message;
            style = "success";
        }
        else
        {
            message = result.Message;
            style = "danger";
        }
    }
    void NevigateToYourUrl()
    {
        _navigationManager.NavigateTo("MailingList/Message", true);
    }
}
