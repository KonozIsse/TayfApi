@page "/contacts"
@inject LocService SharedLocalize
@inject NavigationManager _navigationManager
@inject HomeBL _homeBL
@inject IJSRuntime js
@inject HttpClient http

<PageTitle>@SharedLocalize.GetLocalizedStringValue("contactUs")| @SharedLocalize.GetLocalizedStringValue("ControlPanel")</PageTitle>
<Alert Message="@message" Style="@style"></Alert>
<section class="content-header">
    <h1>  @SharedLocalize.GetLocalizedStringValue("contactUs") <small> @SharedLocalize.GetLocalizedStringValue("contactUs")</small> </h1>
    <ol class="breadcrumb">
        <li class="fa fa-dashboard">@SharedLocalize.GetLocalizedStringValue("dashboard")</li>
        <li class="active"> @SharedLocalize.GetLocalizedStringValue("contactUs") </li>
    </ol>
</section>

<!--  content -->
 @if (Model != null)
{
    <section class="content">
        <!-- Info boxes -->
        <!-- /.row -->
        <div class="row">
            <div class="col-md-12">
                <div class="box">
                    <div class="box-header">
                        <div class="box-header">
                            <div class="col-lg-6 form-inline" id="contact-form">
                                <form class="registration" method="get">
                                    <div class="input-group-form search-panel ">
                                        <select type="button" class="btn btn-default dropdown-toggle form-control" data-toggle="dropdown" @bind="@filter">
                                            <option value="-1" selected="" disabled="" hidden="">@SharedLocalize.GetLocalizedStringValue("FilterBy")</option>
                                            <option value="0">@SharedLocalize.GetLocalizedStringValue("Name")</option>
                                            <option value="1" >@SharedLocalize.GetLocalizedStringValue("Email")</option>
                                        </select>
                                        <input type="text" class="form-control input-group-form" placeholder="@SharedLocalize.GetLocalizedStringValue("search")" @bind-value="@search" />
                                        <button type="button" class="btn btn-primary" @onclick="@GetContact"><i class="oi oi-magnifying-glass"></i></button>
                                        <a @onclick="NevigateToYourUrl" type="button" style="display:inline-block; width: auto; margin-top: 0;" class="btn btn-default"><i class="fa fa-refresh"></i></a>
                                         
                                    </div>
                                </form>
                                <div class="col-lg-4 form-inline" id="contact-form12"></div>
                            </div>

                        </div>

                    </div>

                    <!-- /.box-header -->
                    <div class="box-body">
                        <div class="row">
                            <div class="col-xs-12">
                            </div>
                        </div>


                        <div class="row">
                            <div class="col-xs-12 table-responsive">

                                @if (Model.Count() > 0)
                                {
                                    <table id="example1" class="table table-bordered table-striped">
                                        <thead>
                                            <tr>
                                                <th> #</th>
                                                <th>@SharedLocalize.GetLocalizedStringValue("Name")</th>
                                                <th>@SharedLocalize.GetLocalizedStringValue("Email")</th>
                                                <th>@SharedLocalize.GetLocalizedStringValue("details")</th>
                                                <th>@SharedLocalize.GetLocalizedStringValue("AddedDate")</th>
                                                <th>@SharedLocalize.GetLocalizedStringValue("Actions")</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @{
                                                var i = 0;
                                            }
                                            @foreach (var item in Model)
                                            {

                                                i += 1;
                                                <tr>
                                                    <td>@i</td>
                                                    <td>@item.Name</td>
                                                    <td>@item.Email</td>
                                                    <td style="word-break: break-all;width: 35%;">@item.Message</td>
                                                    <td>@item.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")</td>

                                                    <td>
                                                        <DeleteMessage  OnDelete="@Delete" Id="@item.Id"></DeleteMessage>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                }
                                else
                                {
                                    <div class="col-xs-12 @(lang == "ar"?"text-right":"text-left")">
                                        @SharedLocalize.GetLocalizedStringValue("NoRecordfound").
                                    </div>
                                }

                            </div>
                        </div>
                    </div>
                    <!-- /.box-body -->
                </div>
                <!-- /.box -->
            </div>
            <!-- /.col -->
        </div>
        @if (Model.Count >= 10)
        {
            <Pagination MetaData="MetaData" Spread="2" SelectedPage="SelectedPage" />
        }

    </section>
}
@code {
    [Parameter]
    public string search { get; set; }
    public string filter { get; set; }
    string lang = "en";
    string message = "";
    string style = "";
    public List<ContactDto> Model { get; set; }
    public MetaData MetaData { get; set; } = new MetaData();
    private PostsParameters _PostsParameters = new PostsParameters();

    protected override async Task OnInitializedAsync()
    {
        await GetContact();
    }
    private async Task SelectedPage(int page)
    {
        _PostsParameters.PageNumber = page;
        await GetContact();
    }
    async Task GetContact()
    {
        var pagingResponse = await _homeBL.GetAllContacts(search, filter, _PostsParameters);
        Model = pagingResponse.ToList();
        MetaData = pagingResponse.MetaData;
    }
    async Task Delete(int id)
    {
        var result = await _homeBL.DeleteContact(id);
       
        if (result.Success)
        {
            message = result.Message;
            style = "success";
        }
        else
        {
            message = result.Message;
            style = "danger";
        }
        NevigateToYourUrl();
    }
    void NevigateToYourUrl()
    {
        _navigationManager.NavigateTo("/contacts", true);
    }
}
