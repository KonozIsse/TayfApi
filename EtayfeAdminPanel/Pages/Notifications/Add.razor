@page "/Notification/Add"

<PageTitle>@SharedLocalize.GetLocalizedStringValue("Addproducts") | @SharedLocalize.GetLocalizedStringValue("ControlPanel")</PageTitle>
<Alert Message="@message" Style="@style"></Alert>

<section class="content-header">
    <h1>@SharedLocalize.GetLocalizedStringValue("Notifications") <small>@SharedLocalize.GetLocalizedStringValue("AddNotify")</small> </h1>
    <ol class="breadcrumb">
        <li class="fa fa-dashboard">@SharedLocalize.GetLocalizedStringValue("dashboard")</li>
        <li class="active">@SharedLocalize.GetLocalizedStringValue("AddNotify")</li>
    </ol>
</section>

<!-- Main content -->
<section class="content">
    <!-- Info boxes -->
    <!-- /.row -->

    <div class="row">
        <div class="col-md-12">
            <div class="box">
                <div class="box-header">
                    <h3 class="box-title">@SharedLocalize.GetLocalizedStringValue("AddNotify")</h3>
                </div>

                <!-- /.box-header -->
                <div class="box-body">
                    <div class="row">
                        <div class="col-xs-12">
                            <div class="box box-info">
                                <br>

                                    <div class="form-horizontal">
                                        <div class="box-body">
                                            <div class="form-group">
                                                <label class="col-sm-2 col-md-3 control-label">@SharedLocalize.GetLocalizedStringValue("Name")</label>
                                                <div class="col-sm-10 col-md-4 couponProdcuts">
                                                    <select multiple="" @bind="@create.IdUsers" class="form-control select2 select2-hidden-accessible" required tabindex="-1" aria-hidden="true">
                                                        <option value="0">All Customers</option>
                                                    @if (customers != null)
                                                    {
                                                        @foreach (var c in customers)
                                                        {
                                                            <option value="@c.Id">@c.FullName</option>

                                                        }
                                                    }
                                                    </select>

                                                    <span class="dropdown-wrapper" aria-hidden="true"></span>
                                                    <span class="help-block" style="font-weight: normal;font-size: 11px;margin-bottom: 0;">List of users to send notifications.</span>
                                                </div>
                                            </div>

                                            <div class="form-group">
                                                <label class="col-sm-2 col-md-3 control-label">@SharedLocalize.GetLocalizedStringValue("title") (@SharedLocalize.GetLocalizedStringValue("English"))<span style="color:red;">*</span></label>
                                                <div class="col-sm-10 col-md-4">
                                                <input class="form-control" required="required" type="text" @bind="create.Subject" />
                                                    <span class="help-block" style="font-weight: normal;font-size: 11px;margin-bottom: 0;">@SharedLocalize.GetLocalizedStringValue("title")</span>
                                                    <span class="help-block hidden">@SharedLocalize.GetLocalizedStringValue("Required")</span>
                                                </div>
                                            </div>

                                            <div class="form-group">
                                                <label class="col-sm-2 col-md-3 control-label">@SharedLocalize.GetLocalizedStringValue("title") (@SharedLocalize.GetLocalizedStringValue("Arabic"))<span style="color:red;">*</span></label>
                                                <div class="col-sm-10 col-md-4">
                                                    <input class = "form-control" required = "required" type = "text" @bind="create.SubjectAr"/>
                                                    <span class="help-block" style="font-weight: normal;font-size: 11px;margin-bottom: 0;">@SharedLocalize.GetLocalizedStringValue("title")</span>
                                                    <span class="help-block hidden">@SharedLocalize.GetLocalizedStringValue("Required")</span>
                                                </div>
                                            </div>


                                            <div class="form-group">
                                                <label class="col-sm-2 col-md-3 control-label">@SharedLocalize.GetLocalizedStringValue("desc") (@SharedLocalize.GetLocalizedStringValue("English"))<span style="color:red;">*</span></label>
                                                <div class="col-sm-10 col-md-4">
                                                <textarea @bind="create.Body" class="form-control"  rows=3></textarea>
                                                </div>
                                            </div>

                                            <div class="form-group">
                                                <label class="col-sm-2 col-md-3 control-label">@SharedLocalize.GetLocalizedStringValue("desc") (@SharedLocalize.GetLocalizedStringValue("Arabic"))<span style="color:red;">*</span></label>
                                                <div class="col-sm-10 col-md-4">
                                                <textarea @bind="create.BodyAr" class="form-control" rows=3></textarea>
                                                </div>
                                            </div>

                                            <div class="box-footer text-center">
                                                <button type="submit" class="btn btn-primary" @onclick="CreateNotification">@SharedLocalize.GetLocalizedStringValue("Submit")</button>
                                              <a href="/Notifications" class="btn btn-default">@SharedLocalize.GetLocalizedStringValue("back")</a>  
                                            </div>

                                        </div>

                                    </div>
                                
                            </div>
                        </div>

                    </div>
                    <!-- /.box-body -->
                </div>
                <!-- /.box -->
            </div>
            <!-- /.col -->
        </div>
    </div>
</section>
@code {

    public CreateNotificationDto  create { get; set; }
    private List<CustomerDto> customers;

    protected override async Task OnInitializedAsync()
    {
        create = new CreateNotificationDto();
        customers = await http.GetFromJsonAsync<List<CustomerDto>>("api/Customers/GetCustomers");
    }
    string message = "";
    string style = "";
    async Task CreateNotification()
    {
        var result = await _homeBL.CreateNotification(create);
        if (result.Success)
        {
            message = result.Message;
            style = "success";
        }
        else
        {
            message = result.Message;
            style = "danger";
        }
    }


}