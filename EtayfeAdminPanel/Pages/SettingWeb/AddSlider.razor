@page "/SettingWeb/AddSlide"

<PageTitle>@SharedLocalize.GetLocalizedStringValue("addSlider") | @SharedLocalize.GetLocalizedStringValue("ControlPanel")</PageTitle>


<section class="content-header">
    <h1>@SharedLocalize.GetLocalizedStringValue("slider")<small>@SharedLocalize.GetLocalizedStringValue("addSlider")</small> </h1>
    <ol class="breadcrumb">
        <li class="fa fa-dashboard" >@SharedLocalize.GetLocalizedStringValue("dashboard")</li>
        <li class="fa fa-users">@SharedLocalize.GetLocalizedStringValue("slider")</li>
        <li class="active">@SharedLocalize.GetLocalizedStringValue("addSlider")</li>
    </ol>
</section>
<Alert Message="@message" Style="@style"></Alert>
<!-- Main content -->
<section class="content">
    @if (languges != null)
    {
        <div class="row">
            <div class="col-md-12">
                <div class="box">
                    <div class="box-header">
                        <h3 class="box-title">@SharedLocalize.GetLocalizedStringValue("addSlider")</h3>
                    </div>

                    <!-- /.box-header -->
                    <div class="box-body">
                        <div class="row">
                            <div class="col-xs-12">
                                <div class="box box-info">
                                    <br>
                                    <EditForm Model="@create" OnValidSubmit="@AddSliderWeb">
                                        <DataAnnotationsValidator />
                                        <div class="form-horizontal">
                                            <div class="box-body">

                                                <div class="row">

                                                   
                                                        <div class="form-group">
                                                        <label class="col-sm-2 col-md-3 control-label">@SharedLocalize.GetLocalizedStringValue("Name") (en)</label>
                                                            <div class="col-sm-10 col-md-8">
                                                                <InputText  class="form-control"  @bind-Value="@create.Title"  />
                                                                <ValidationMessage For="@(() => create.Title)" />
                                                            </div>
                                                        </div>
                                                        <div class="form-group">
                                                        <label class="col-sm-2 col-md-3 control-label">@SharedLocalize.GetLocalizedStringValue("desc") (en)</label>
                                                            <div class="col-sm-10 col-md-8">
                                                                <InputTextArea class="form-control" @bind-Value="@create.Decription"></InputTextArea>
                                                                <ValidationMessage For="@(() => create.Decription)" />
                                                            </div>
                                                        </div>
                                                        <div class="form-group">
                                                        <label class="col-sm-2 col-md-3 control-label">@SharedLocalize.GetLocalizedStringValue("Name") (ar) </label>
                                                            <div class="col-sm-10 col-md-8">
                                                                <InputText class="form-control" @bind-Value="@create.TitleAr" />
                                                                <ValidationMessage For="@(() => create.TitleAr)" />
                                                            </div>
                                                        </div>
                                                        <div class="form-group">
                                                        <label class="col-sm-2 col-md-3 control-label">@SharedLocalize.GetLocalizedStringValue("desc") (ar)</label>
                                                            <div class="col-sm-10 col-md-8">
                                                                <InputTextArea class="form-control" @bind-Value="@create.DecriptionAr"></InputTextArea>
                                                                <ValidationMessage For="@(() => create.DecriptionAr)" />
                                                            </div>
                                                        </div>
                                                    


                                                    <div class="form-group">
                                                        <label class="col-sm-2 col-md-3 control-label">@SharedLocalize.GetLocalizedStringValue("link") </label>
                                                        <div class="col-sm-10 col-md-8">
                                                            <InputText class="form-control" @bind-Value="create.Url" />
                                                            <ValidationMessage For="@(() => create.Url)" />
                                                        </div>
                                                    </div>

                                                    <div class="form-group">
                                                        <label class="col-sm-2 col-md-3 control-label">@SharedLocalize.GetLocalizedStringValue("lang") </label>
                                                        <div class="col-sm-10 col-md-8">
                                                            <InputSelect class="form-control" @bind-Value="create.LangId" style="width:300px">

                                                                <option value="">Languges</option>
                                                                @foreach (var language in languges)
                                                                {
                                                                    <option value="@language.Id">@language.Name</option>
                                                                }

                                                            </InputSelect>
                                                        <ValidationMessage For="@(() => create.LangId)" />
                                                    </div>
                                                </div>

                                                    <div class="form-group" id="imageIcone">
                                                        <label class="col-sm-2 col-md-3 control-label">@SharedLocalize.GetLocalizedStringValue("img")<span style="color:red;">*</span></label>
                                                        <div class="col-sm-10 col-md-4">
                                                            <!-- Modal -->
                                                            <div class="modal fade embed-images" id="ModalmanufacturedICone" tabindex="-1" role="dialog" aria-labelledby="myModalLabel">
                                                                <div class="modal-dialog" role="document">
                                                                    <div class="modal-content">
                                                                        <div class="modal-header">
                                                                            <button type="button" class="close" data-dismiss="modal" id="closemodal" aria-label="Close"><span aria-hidden="true">×</span></button>
                                                                            <h3 class="modal-title text-primary" id="myModalLabel">@SharedLocalize.GetLocalizedStringValue("addImg")</h3>
                                                                        </div>
                                                                        <div class="modal-body manufacturer-image-embed">
                                                                            @if (images != null)
                                                                            {
                                                                                <ul class="thumbnails image_picker_selector">

                                                                                    @foreach (var i in images)
                                                                                    {
                                                                                        <li>
                                                                                            <span class="emailTable">
                                                                                                <label title="Spreadsheet for accounting">
                                                                                                    <div class="thumbnail">

                                                                                                        <img class="image_picker_image" src="@i.Path" alt="@i.Id">
                                                                                                        <input @onclick="(()=>Select(i.Path,i.ImgId))" type="checkbox" value="@i.Path" />
                                                                                                    </div>
                                                                                                </label>
                                                                                            </span>
                                                                                        </li>
                                                                                    }
                                                                                </ul>
                                                                            }
                                                                        </div>
                                                                        <div class="modal-footer">
                                                                            <a href="/Media" target="_blank" class="btn btn-primary pull-left">@SharedLocalize.GetLocalizedStringValue("addImg")</a>
                                                                            <a class="btn btn-default refresh-image shownotify newIcon" id="reff"><i class="fa fa-refresh"></i></a>
                                                                            <button type="button" class="btn btn-success" id="selectedICONE" data-dismiss="modal">@SharedLocalize.GetLocalizedStringValue("add")</button>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                            <div id="imageselected">
                                                                <input value="Blogs" hidden id="typeImg" />
                                                                <a id="newIcon" data-id="1" class="newIcon btn btn-primary field-validate" data-toggle="modal" data-target="#ModalmanufacturedICone" type="button">@SharedLocalize.GetLocalizedStringValue("addImg")</a>
                                                                <br>
                                                                <div id="selectedthumbnailIcon" class="selectedthumbnail col-md-5"> </div>
                                                                <div class="closimage">
                                                                    <button type="button" class="close pull-left image-close " id="image-Icone" style="display: none; position: absolute;left: 105px; top: 54px; background-color: black; color: white; opacity: 2.2; " aria-label="Close">
                                                                        <span aria-hidden="true">×</span>
                                                                    </button>
                                                                </div>
                                                            </div>
                                                            <img width="80px" src="@image" />
                                                            <span class="help-block" style="font-weight: normal;font-size: 11px;margin-bottom: 0;">@SharedLocalize.GetLocalizedStringValue("UploadYourImages")</span>

                                                            <br>
                                                        </div>
                                                    </div>


                                                <div class="box-footer text-center">
                                                    <button type="submit" class="btn btn-primary">@SharedLocalize.GetLocalizedStringValue("Submit")</button>
                                                    <a href="/SettingWeb/Sliders" type="submit" class="btn btn-defult">@SharedLocalize.GetLocalizedStringValue("back")</a>
                                                </div>


                                            </div>

                                        </div>
                                        <!-- /.box-body -->
                                    </div>
                                </EditForm>
                                <!-- /.box -->
                            </div>
                            <!-- /.col -->
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
   }
</section>

@code {
    [Parameter]
    public CreateSliderDto create { get; set; }
    public List<LanguageDto> languges { get; set; }
    public string lang { get; set; }
    public List<ImageSettingDto> images { get; set; }
    public string image { get; set; }
    public AdminDto user { get; set; }
    protected override async Task OnInitializedAsync()
    {
        create = new CreateSliderDto();
        http.DefaultRequestHeaders.Add("Accept", "application/json");
        lang = await http.GetFromJsonAsync<string>("api/Language/GetDefaultLanugage");
        languges = await http.GetFromJsonAsync<List<LanguageDto>>("api/Language/GetLanguages");
        user = await http.GetFromJsonAsync<AdminDto>("api/Account/currentUser");
        images = await http.GetFromJsonAsync<List<ImageSettingDto>>("api/Home/GetAllImagesOriginal");
    }
    string message = "";
    string style = "";
    async Task AddSliderWeb()
    {
        var result = await _homeBL.AddSliderWeb(user.Id,create);
        if (result.Success)
        {
            message = result.Message;
            style = "success";
        }
        else
        {
            message = result.Message;
            style = "danger";
        }
    }
    public void Select(string image1, int imgId)
    {
        image = image1;
        create.ImageId = imgId;
    }
}
