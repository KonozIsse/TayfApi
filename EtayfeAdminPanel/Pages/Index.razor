@page "/"
@inject HomeBL _homeBL
<PageTitle> @SharedLocalize.GetLocalizedStringValue("dashboard")</PageTitle>
@if (home != null)
{
    <section class="content">
        <div class="row">
            <div class="col-lg-4 col-xs-6">
                <!-- small box -->
                <div class="small-box bg-aqua">
                    <div class="inner">
                        <h3>@home.TotalOrders</h3>
                        <p>@SharedLocalize.GetLocalizedStringValue("Orders")</p>
                    </div>
                    <div class="icon">
                        <i class="ion ion-bag"></i>
                    </div>
                    <a class="small-box-footer" href="/CP/Orders" data-toggle="tooltip" data-placement="bottom" title="">@SharedLocalize.GetLocalizedStringValue("ViewAllOrders") <i class="fa fa-arrow-circle-right"></i></a>
                </div>
            </div>
            <!-- ./col -->
            <div class="col-lg-4 col-xs-6">
                <!-- small box -->
                <div class="small-box bg-light-blue ">
                    <div class="inner">
                        <h3>QAR @home.TotalPurchased </h3>
                        <p>@SharedLocalize.GetLocalizedStringValue("TotalPurchasedMoney")</p>
                    </div>
                    <div class="icon">
                        <i class="ion ion-bag"></i>
                    </div>

                    <a href="/CP/Reports/CustomerReport" class="small-box-footer" data-toggle="tooltip" data-placement="bottom" title="">@SharedLocalize.GetLocalizedStringValue("TotalPurchasedMoney") <i class="fa fa-arrow-circle-right"></i></a>
                </div>
            </div>
            <!-- ./col -->
            <div class="col-lg-4 col-xs-6">
                <!-- small box -->
                <div class="small-box bg-teal">
                    <div class="inner">
                        <h3> QAR  @home.TotalTransactions </h3>
                        <p>@SharedLocalize.GetLocalizedStringValue("TotalTransactions")</p>
                    </div>
                    <div class="icon">
                        <i class="ion ion-bag"></i>
                    </div>
                    <a href="/CP/Reports/SalesRep"
                   class="small-box-footer" data-toggle="tooltip" data-placement="bottom" title="">@SharedLocalize.GetLocalizedStringValue("TotalTransactions")<i class="fa fa-arrow-circle-right"></i></a>
                </div>
            </div>
        </div>
        <div class="row">
            <!-- ./col -->
            <div class="col-lg-4 col-xs-6">

                <div class="small-box bg-red">
                    <div class="inner">
                        <h3>@home.TotalOutStock </h3>
                        <p>@SharedLocalize.GetLocalizedStringValue("OutofStock")</p>
                    </div>
                    <div class="icon">
                        <i class="ion ion-stats-bars"></i>
                    </div>
                    <a href="/CP/Reports/OutStock" class="small-box-footer" data-toggle="tooltip" data-placement="bottom" title="">@SharedLocalize.GetLocalizedStringValue("OutofStock")<i class="fa fa-arrow-circle-right"></i></a>

                    @*<a href="/admin/@lang/CP/Reports/OutStockRep" class="small-box-footer" data-toggle="tooltip" data-placement="bottom" title="" >@SharedLocalize.GetLocalizedStringValue("")OutofStock <i class="fa fa-arrow-circle-right"></i></a>*@
                </div>
            </div>
            <!-- ./col -->
            <div class="col-lg-4 col-xs-6">
                <!-- small box -->
                <div class="small-box bg-yellow">
                    <div class="inner">
                        <h3>@home.TotalCustomerRegistrations</h3>

                        <p>@SharedLocalize.GetLocalizedStringValue("CustomerRegistrations")</p>
                    </div>
                    <div class="icon">
                        <i class="ion ion-person-add"></i>
                    </div>
                    <a href="/CP/Customers" class="small-box-footer" data-toggle="tooltip" data-placement="bottom" title="">@SharedLocalize.GetLocalizedStringValue("ViewAllCustomers")  <i class="fa fa-arrow-circle-right"></i></a>

                    @*<a href="/admin/@lang/CP/Customers/" class="small-box-footer" data-toggle="tooltip" data-placement="bottom" title="" >@SharedLocalize.GetLocalizedStringValue("")ViewAllCustomers  <i class="fa fa-arrow-circle-right"></i></a>*@
                </div>
            </div>
            <!-- ./col -->
            <div class="col-lg-4 col-xs-6">
                <!-- small box -->
                <div class="small-box bg-green">
                    <div class="inner">
                        <h3>@home.TotalProducts</h3>

                        <p>@SharedLocalize.GetLocalizedStringValue("TotalProducts")</p>
                    </div>
                    <div class="icon">
                        <i class="ion ion-pie-graph"></i>
                    </div>
                    <a href="/CP/Products" class="small-box-footer" data-toggle="tooltip" data-placement="bottom" title="">@SharedLocalize.GetLocalizedStringValue("ViewAllProducts") <i class="fa fa-arrow-circle-right"></i></a>

                    @*<a href="/admin/@lang/CP/Products/" class="small-box-footer" data-toggle="tooltip" data-placement="bottom" title="">@SharedLocalize.GetLocalizedStringValue("")ViewAllProducts <i class="fa fa-arrow-circle-right"></i></a>*@
                </div>
            </div>
            <!-- ./col -->
        </div>

        <div class="row">
        </div>
        <!-- /.row -->
        <!-- Main row -->
        <div class="row">
            <!-- Left col -->
            <div class="col-md-8">
                <!-- MAP & BOX PANE -->
                <!-- /.box -->
                <div class="row">
                    <!-- /.col -->

                    <div class="col-md-12">
                        <!-- USERS LIST -->
                        <div class="box box-danger">
                            <div class="box-header with-border">
                                <h3 class="box-title">@SharedLocalize.GetLocalizedStringValue("NewCustomer") (@home.TotalCustomerRegistrations)</h3>
                            </div>

                            <!-- /.box-header -->
                            @if (home.TotalCustomerRegistrations > 0)
                            {
                                <div class="box-body no-padding">
                                    <ul class="users-list clearfix">
                                        @foreach (var f in usrs)
                                        {
                                            <li>
                                                @if (String.IsNullOrEmpty(f.Avater))
                                                {
                                                    <img src="/avatars/person-male-1.jpg" style="width: 50px !important;border-radius: 50% !important;">
                                                }
                                                else
                                                {
                                                    <img src="@f.Avater" style="width: 50px !important;border-radius: 50% !important;">
                                                }
                                                <a class="users-list-name" href="/CP/Customer/Edit/@f.Id"> @f.FullName</a>
                                                <span class="users-list-date">@f.CreatedAt</span>
                                            </li>
                                        }


                                    </ul>

                                    <!-- /.users-list -->
                                </div>
                                <!-- /.box-body -->
                                <div class="box-footer text-center">
                                    <a href="/CP/Customers" class="uppercase" data-toggle="tooltip" data-placement="bottom" title="View All Customers">@SharedLocalize.GetLocalizedStringValue("ViewAllCustomers")</a>

                                    @*<a href="/admin/@lang/CP/Customers/" class="uppercase" data-toggle="tooltip" data-placement="bottom" title="View All Customers">@SharedLocalize.GetLocalizedStringValue("")ViewAllCustomers</a>*@
                                </div>
                            }
                            <!-- /.box-footer -->
                        </div>
                        <!--/.box -->
                    </div>
                    <!-- /.col -->
                </div>
                <!-- /.row -->
                <!-- TABLE: LATEST ORDERS -->
                <div class="box box-info">
                    <div class="box-header with-border">
                        <h3 class="box-title">@SharedLocalize.GetLocalizedStringValue("NewOrders")</h3>


                    </div>
                    @if (ords.Count() > 0)
                    {
                        <!-- /.box-header -->
                        <div class="box-body">
                            <div class="table-responsive">
                                <table class="table no-margin">
                                    <thead>
                                        <tr>
                                            <th>@SharedLocalize.GetLocalizedStringValue("OrderID")</th>
                                            <th>@SharedLocalize.GetLocalizedStringValue("CustomerName")</th>
                                            <th>@SharedLocalize.GetLocalizedStringValue("total")</th>
                                            <th>@SharedLocalize.GetLocalizedStringValue("OrderStatusName") </th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var d in ords)
                                        {
                                            string nm = d.CustomerName;



                                            <tr>
                                                <td>
                                                    <a href="/CP/Orders" data-toggle="tooltip" data-placement="bottom" title="Go to detail">@d.Id</a>
                                                </td>

                                                <td>@nm</td>
                                                <td>
                                                    QAR @d.OrderPrice
                                                </td>

                                                @if (d.OrderStatusEnum == OrderStatusEnum.OrderPending)
                                                {
                                                    <td><span class="label label-warning">@d.OrderStatusName</span></td>

                                                }
                                                else if (d.OrderStatusEnum == OrderStatusEnum.OrderCompleted)
                                                {
                                                    <td><span class="label label-success">@d.OrderStatusName</span></td>
                                                }
                                                else if (d.OrderStatusEnum == OrderStatusEnum.OrderCanceled)
                                                {
                                                    <td><span class="label label-danger">@d.OrderStatusName</span></td>
                                                }
                                                else if (d.OrderStatusEnum == OrderStatusEnum.OrderRejcted)
                                                {
                                                    <td><span class="label label-danger">@d.OrderStatusName</span></td>
                                                }
                                                else
                                                {
                                                    <td><span class="label label-info">@d.OrderStatusName</span></td>
                                                }

                                            </tr>
                                        }

                                    </tbody>
                                </table>
                            </div>
                            <!-- /.table-responsive -->
                        </div>
                        <!-- /.box-body -->
                        <div class="box-footer clearfix">
                            <a href="/CP/Orders" class="btn btn-sm btn-default btn-flat pull-right" data-toggle="tooltip" data-placement="bottom" title="View All Orders">@SharedLocalize.GetLocalizedStringValue("ViewAllOrders")</a>

                            @*<a href="/admin/@lang/CP/Orders/" class="btn btn-sm btn-default btn-flat pull-right" data-toggle="tooltip" data-placement="bottom" title="View All Orders">@SharedLocalize.GetLocalizedStringValue("")ViewAllOrders</a>*@
                        </div>
                    }
                    <!-- /.box-footer -->
                </div>

                <!--VENDORS-->
                <div class="box box-info">
                    <div class="box-header with-border">
                        <h3 class="box-title">@SharedLocalize.GetLocalizedStringValue("NewStores")</h3>


                    </div>
                    @if (vend.Count() > 0)
                    {
                        <!-- /.box-header -->
                        <div class="box-body">
                            <div class="table-responsive">
                                <table class="table no-margin">
                                    <thead>
                                        <tr>
                                            <th>@SharedLocalize.GetLocalizedStringValue("img")</th>
                                            <th>@SharedLocalize.GetLocalizedStringValue("Name")</th>
                                            <th>@SharedLocalize.GetLocalizedStringValue("Mobile")</th>
                                            <th>@SharedLocalize.GetLocalizedStringValue("Address")</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var d in vend)
                                        {

                                            <tr>
                                                <td><img src="@d.Image" style="width: 50px !important;border-radius: 50% !important;"></td>
                                                <td>@d.FirstName</td>
                                                <td>@d.PhoneNumber</td>
                                                <td>
                                                    @d.AdressInfo
                                                </td>

                                            </tr>

                                        }

                                    </tbody>
                                </table>
                            </div>
                            <!-- /.table-responsive -->
                        </div>

                        <!-- /.box-body -->
                        <div class="box-footer clearfix">
                            <a href="/CP/Vendors" class="btn btn-sm btn-default btn-flat pull-right" data-toggle="tooltip" data-placement="bottom" title="View All Orders">@SharedLocalize.GetLocalizedStringValue("ViewAllStores")</a>

                            @*<a href="/admin/@lang/CP/ManageVendors/" class="btn btn-sm btn-default btn-flat pull-right" data-toggle="tooltip" data-placement="bottom" title="View All Orders">@SharedLocalize.GetLocalizedStringValue("")ViewAllStores</a>*@
                        </div>
                    }
                    <!-- /.box-footer -->
                </div>
                <!-- /.box -->
            </div>
            <!-- /.col -->

            <div class="col-md-4">

                <!-- PRODUCT LIST -->

                <div class="box box-primary">
                    <div class="box-header with-border">
                        <h3 class="box-title">@SharedLocalize.GetLocalizedStringValue("GoalCompletion")</h3>
                    </div>

                    <div class="box-body">

                        <div class="progress-group">
                            <span class="progress-text">@SharedLocalize.GetLocalizedStringValue("AddProductstoCart")</span>
                            <span class="progress-number"><b>@home.TotalCarts </b>/@home.TotalProducts</span>

                            <div class="progress sm">
                                <div class="progress-bar progress-bar-aqua" style="width: @(home.CartsPercentage+"%")"></div>
                            </div>
                        </div>
                        <!-- /.progress-group -->
                        <div class="progress-group">
                            <span class="progress-text"> @SharedLocalize.GetLocalizedStringValue("CompleteOrders")</span>
                            <span class="progress-number"><b>@home.CompleteOrders</b>/@home.TotalOrders</span>
                            <div class="progress sm">
                                <div class="progress-bar progress-bar-green" style="width:@(home.CompletePercentage+"%")"></div>
                            </div>
                        </div>
                        <!-- /.progress-group -->
                        <div class="progress-group">
                            <span class="progress-text"> @SharedLocalize.GetLocalizedStringValue("PendingOrders")</span>
                            <span class="progress-number"><b>@home.PendingOrders </b>/@home.TotalOrders</span>
                            <div class="progress sm">
                                <div class="progress-bar progress-bar-yellow" style="width: @(home.PendingPercentage+"%")"></div>
                            </div>
                        </div>
                        <!-- /.progress-group -->
                        <div class="progress-group">
                            <span class="progress-text">@SharedLocalize.GetLocalizedStringValue("CanceledOrders")</span>
                            <span class="progress-number"><b>@home.CansalOrders</b>/@home.TotalOrders</span>
                            <div class="progress sm">
                                <div class="progress-bar progress-bar-red" style="width: @(home.CansalPercentage+"%")"></div>
                            </div>
                        </div>
                    </div>
                    <!-- /.box-body -->
                </div>
                <div class="box box-primary">
                    <div class="box-header with-border">
                        <h3 class="box-title">@SharedLocalize.GetLocalizedStringValue("RecentlyAddedProducts")</h3>

                    </div>
                    @if (prods.Count() > 0)
                    {
                        <!-- /.box-header -->
                        <div class="box-body">
                            <ul class="products-list product-list-in-box">
                                @foreach (var p in prods)
                                {

                                    <li class="item">
                                        <div class="product-img">
                                            <img src="@p.ImageProduct" alt="" width=" 100px" height="100px">
                                        </div>
                                        <div class="product-info">


                                            <a href="/CP/Product/Edit/@p.Id" class="product-title">
                                                @p.ProductName<span class="label label-warning label-succes pull-right">QAR @p.Price </span>
                                            </a>

                                        </div>
                                    </li>
                                }
                            </ul>
                        </div>
                        <!-- /.box-body -->
                        <div class="box-footer text-center">
                            <a href="/CP/Products" class="uppercase" data-toggle="tooltip" data-placement="bottom" title="View All Products">@SharedLocalize.GetLocalizedStringValue("ViewAllProducts")</a>
                        </div>
                    }
                    <!-- /.box-footer -->
                </div>
                <!-- /.box -->
            </div>
            <!-- /.col -->
        </div>
        <!-- /.row -->
    </section>
}

@code {
    [Parameter]
    public string lang { get; set; }
    public List<ProductDto> prods { get; set; }
    public List<StoreDto> vend { get; set; }
    public List<CustomerDto> usrs { get; set; }
    public List<OrderDto> ords { get; set; }
    public HomeCPVM home { get; set; }


    protected override async Task OnInitializedAsync()
    {
        // lang = await _homeBL.GetDefaultLanugage();
        //await http.GetFromJsonAsync<string>("api/Language/getDefaultLang");
        lang = "en";
        home = await http.GetFromJsonAsync<HomeCPVM>("api/Home/GetTotalOrdersProducts"); 
        prods = await http.GetFromJsonAsync<List<ProductDto>>("api/Home/getRecentProducts");
        vend = await http.GetFromJsonAsync<List<StoreDto>>("api/Home/getNewStores");
        usrs = await http.GetFromJsonAsync<List<CustomerDto>>("api/Home/getNewCustomers");
        ords = await http.GetFromJsonAsync<List<OrderDto>>("api/Home/getNewOrders");
    }
   
}

   